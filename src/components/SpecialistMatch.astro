---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Specialist {
  name: string;
  credentials: string;
  photo: ImageMetadata;
  blurb: string;
  href: string;
}

interface Props {
  heading: string;
  specialists: Specialist[];
}

const { heading, specialists } = Astro.props;
---

<section class="specialist-match">
  <div class="match-inner">
    <h2>{heading}</h2>
    <div class="match-grid">
      {specialists.map((s) => (
        <a class="match-card" href={s.href}>
          <div class="match-photo-frame">
            <Image class="match-photo" src={s.photo} alt={s.name} width={400} format="webp" quality={75} />
          </div>
          <div class="match-copy">
            <p class="match-name">{s.name}</p>
            <p class="match-credentials">{s.credentials}</p>
            <p class="match-blurb">{s.blurb}</p>
            <span class="match-link">View Full Bio →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .specialist-match {
    background: var(--color-bg);
    padding-block: var(--space-8);
  }
  .match-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
    text-align: center;
  }
  h2 {
    font-size: clamp(1.85rem, 3.2vw, 2.5rem);
    color: var(--color-fg);
    margin: 0 0 var(--space-6);
  }
  .match-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
  }
  .match-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 380px;
    max-width: 100%;
    text-align: left;
    text-decoration: none;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s ease;
  }
  .match-card:hover {
    border-color: var(--color-primary);
  }
  .match-photo-frame {
    flex-shrink: 0;
    width: 96px;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--color-primary);
  }
  .match-photo-frame :global(.match-photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .match-name {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.15rem;
    color: var(--color-fg);
    margin: 0;
  }
  .match-credentials {
    font-family: var(--font-body);
    font-weight: var(--font-weight-nav);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin: 2px 0 var(--space-2);
  }
  .match-blurb {
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-fg);
    opacity: 0.8;
    margin: 0 0 var(--space-2);
  }
  .match-link {
    font-family: var(--font-body);
    font-weight: var(--font-weight-nav);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }
</style>
