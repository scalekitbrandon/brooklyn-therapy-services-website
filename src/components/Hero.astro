---
interface Props {
  eyebrow?: string;
  headline: string;
  subhead: string;
  tags?: string[];
  primaryLabel: string;
  primaryHref: string;
  videoSrc: string;
}

const { headline, subhead, tags = [], primaryLabel, primaryHref, videoSrc } = Astro.props;
---

<section class="hero">
  <video class="hero-video" autoplay muted loop playsinline poster="/videos/hero-poster.jpg">
    <source src={videoSrc} type="video/mp4" />
  </video>
  <div class="hero-scrim"></div>
  <div class="hero-content">
    <h1>{headline}</h1>
    <p class="subhead">{subhead}</p>
    {tags.length > 0 && (
      <div class="hero-tags">
        <span class="tags-rule" aria-hidden="true"></span>
        <p class="tags-line">{tags.join('  ·  ')}</p>
      </div>
    )}
    <div class="hero-ctas">
      <a class="hero-btn primary" href={primaryHref}>{primaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(41, 35, 30, 0.35) 0%, rgba(41, 35, 30, 0.55) 100%);
  }
  .hero-content {
    position: relative;
    height: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-4);
    gap: var(--space-3);
  }
  .hero-content h1 {
    color: var(--color-bg);
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.15;
    max-width: 900px;
  }
  .subhead {
    color: var(--color-bg);
    font-family: var(--font-body);
    font-weight: var(--font-weight-nav);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }
  .hero-tags {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .tags-rule {
    width: 48px;
    height: 1px;
    background: var(--color-muted);
    opacity: 0.6;
  }
  .tags-line {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-style: italic;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    letter-spacing: 0.02em;
    color: var(--color-muted);
    opacity: 0.95;
    max-width: 640px;
  }
  .hero-ctas {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2);
  }
  .hero-btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: var(--font-weight-button);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .hero-btn:hover {
    opacity: 0.85;
  }
  .hero-btn.primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }
</style>
