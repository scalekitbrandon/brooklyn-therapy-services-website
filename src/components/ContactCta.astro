---
import { Image } from 'astro:assets';
import contactBg from '../assets/images/contact-bg.jpg';

interface Props {
  eyebrow?: string;
  heading?: string;
  supporting?: string;
  details?: { label: string; value: string }[];
}

const {
  eyebrow = 'Get In Touch',
  heading = "Let's Talk",
  supporting = "Reach out to schedule a free consultation or ask a question — we'll get back to you within one business day.",
  details = [],
} = Astro.props;
---

<section class="contact-cta" id="consultation-form">
  <Image class="contact-bg" src={contactBg} alt="" width={2000} format="webp" quality={70} loading="lazy" />
  <div class="contact-scrim"></div>
  <div class="contact-inner">
    <div class="contact-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{heading}</h2>
    </div>

    <div class="contact-grid">
      <div class="contact-copy">
        <p class="supporting">{supporting}</p>
        {details.length > 0 && (
          <ul class="details">
            {details.map((d) => (
              <li>
                <span class="detail-label">{d.label}</span>
                <span class="detail-value">{d.value}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="contact-form">
        <iframe
          src="https://api.leadconnectorhq.com/widget/form/nxujEIFu9bvIaNYHP0Mc"
          style="width:100%;height:100%;border:none;border-radius:0px"
          id="inline-nxujEIFu9bvIaNYHP0Mc"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="Brooklyn Therapy Services Website Form"
          data-height="460"
          data-layout-iframe-id="inline-nxujEIFu9bvIaNYHP0Mc"
          data-form-id="nxujEIFu9bvIaNYHP0Mc"
          data-cookie-consent="true"
          data-cookie-consent-provider="auto"
          title="Brooklyn Therapy Services Website Form"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    position: relative;
    background: var(--color-fg);
    padding-block: var(--space-6);
    overflow: hidden;
  }
  .contact-cta :global(.contact-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .contact-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(41, 35, 30, 0.6) 0%, rgba(41, 35, 30, 0.78) 100%);
    z-index: 1;
  }
  .contact-inner {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .contact-header {
    text-align: center;
    margin-bottom: var(--space-5);
  }
  .eyebrow {
    font-family: var(--font-body);
    font-weight: var(--font-weight-nav);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin: 0 0 var(--space-2);
  }
  h2 {
    font-size: clamp(2rem, 3.2vw, 2.5rem);
    color: var(--color-bg);
    margin: 0;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: center;
  }
  .contact-copy {
    padding-top: 0;
  }
  .supporting {
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-muted);
    opacity: 0.9;
    margin: 0 0 var(--space-4);
    max-width: 440px;
  }
  .details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .details li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .detail-label {
    font-family: var(--font-body);
    font-weight: var(--font-weight-nav);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .detail-value {
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
    font-size: 1rem;
    color: var(--color-bg);
  }
  .contact-form {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: var(--space-5);
  }
  .contact-form iframe {
    display: block;
    width: 100%;
    height: 460px;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>
