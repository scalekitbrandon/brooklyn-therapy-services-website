---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = '', noindex = false } = Astro.props;

// GA4 measurement ID (G-XXXXXXX). Set PUBLIC_GA_ID in the Cloudflare build
// environment; the tag only renders once it is set.
const gaId = import.meta.env.PUBLIC_GA_ID;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
const logoURL = new URL('/logo.png', Astro.site);

// Only real, verified fields — no placeholder address or phone number.
// This business has neither a public address nor a phone line.
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: 'Brooklyn Therapy Services',
  description: 'Individual and couples therapy in Brooklyn and online across New York.',
  url: Astro.site?.toString(),
  email: 'info@brooklyntherapyservices.com',
  image: logoURL.toString(),
  logo: logoURL.toString(),
  areaServed: [
    { '@type': 'City', name: 'Brooklyn, NY' },
    { '@type': 'State', name: 'New York' },
  ],
  knowsAbout: [
    'Anxiety', 'Depression', 'OCD', 'Trauma and PTSD', 'Couples therapy',
    'Grief and loss', 'Life transitions', 'Stress and burnout',
    'Acceptance and Commitment Therapy (ACT)', 'Cognitive Behavioral Therapy (CBT)',
    'Exposure and Response Prevention (ERP)', 'Internal Family Systems (IFS)',
    'Psychodynamic therapy',
  ],
  founder: { '@id': `${Astro.site}team#rachel-vetter` },
  employee: [
    {
      '@type': 'Person',
      '@id': `${Astro.site}team#rachel-vetter`,
      name: 'Rachel Vetter',
      jobTitle: 'Founder & Clinical Director',
      honorificSuffix: 'LCSW',
      alumniOf: 'Fordham University Graduate School of Social Service',
      url: `${Astro.site}team`,
    },
    {
      '@type': 'Person',
      '@id': `${Astro.site}team#lily-berman`,
      name: 'Lily Berman',
      jobTitle: 'Clinician',
      honorificSuffix: 'LMSW',
      url: `${Astro.site}team`,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Inter:wght@400;500&display=swap"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Brooklyn Therapy Services" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    margin: 0;
  }
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
</style>
