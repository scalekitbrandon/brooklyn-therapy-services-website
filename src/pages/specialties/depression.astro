---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'Depression', href: '/specialties/depression' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Depression Therapy in Brooklyn | Brooklyn Therapy Services"
  description="Depression therapy in Brooklyn and online across New York. CBT, ACT and psychodynamic care for low mood, withdrawal and self-criticism. Free consultation."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Depression Therapy in Brooklyn, NY"
    intro="Support for the low mood, withdrawal, and self-critical thinking that can make everyday life feel heavy. Depression therapy at Brooklyn Therapy Services helps you understand what is keeping you stuck and take small, steady steps back toward the things that matter to you."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Depression Therapy?"
    paragraphs={[
      'Depression therapy is focused treatment for persistent low mood, loss of interest, and the patterns of thinking and withdrawal that tend to keep depression going.',
      'Depression often runs on a cycle: low mood leads to pulling back from activities and people, which removes sources of reward and connection, which deepens the low mood. Therapy works on both sides of that cycle, the thoughts and the behavior, while also making room for the experiences and history underneath it.',
      'Sessions typically happen weekly, in 50-minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs Depression Therapy Might Help"
    intro="Depression doesn't always look like sadness. You might be a fit for this work if:"
    signs={[
      "You've lost interest in things you used to enjoy or find meaningful",
      'You feel flat, heavy, or tired most days, even after rest',
      'Thoughts like "what\'s the point" or "I\'m too far behind" have become familiar',
      "You're pulling back from friends, work, or routines",
      'Getting started on everyday tasks takes more effort than it used to',
      'Low mood keeps returning, even when things on paper seem fine',
    ]}
    note="Depression tends to convince you that nothing will help before you've tried. Part of the work is testing that belief, one small step at a time."
  />

  <ProseSection
    heading="Our Approach to Depression"
    paragraphs={[
      'We draw from <a href="/approach/cbt/for-depression">CBT for depression</a>, which combines testing depressive thoughts against real evidence with behavioral activation, and <a href="/approach/act/for-depression">ACT for depression</a>, which focuses on values-aligned action even before mood improves.',
      'Because depression rarely exists in isolation, we also use <a href="/approach/psychodynamic">psychodynamic therapy</a> to explore the relationships, experiences, and patterns underneath it, so change lasts beyond the current episode.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Treat Depression"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Works with individuals and couples navigating depression, grief, and major life transitions, using an integrative blend of psychodynamic work, ACT, and CBT.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for depression, integrating CBT alongside ACT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Do I need a diagnosis of depression to start?',
        answer: 'No. Many people come in because low mood or loss of motivation is getting in the way of their life. We can talk through what you are noticing during a free consultation.',
      },
      {
        question: 'How long does depression therapy take?',
        answer: "It depends on severity, history, and goals. Some clients notice meaningful shifts within a few months of consistent work; others continue longer. We'll set a plan together early on.",
      },
      {
        question: 'Can therapy be combined with medication?',
        answer: 'Yes. Many clients use therapy and medication together. We do not prescribe, but we can discuss whether a referral to a prescriber makes sense for you.',
      },
      {
        question: 'Do you offer online therapy for depression?',
        answer: 'Yes. We offer online depression therapy for clients located anywhere in New York, in addition to in-person sessions in Brooklyn.',
      },
      {
        question: 'What if I am in crisis or having thoughts of suicide?',
        answer: 'We are not a crisis service. If you are in immediate danger, call 911. You can call or text 988 to reach the 988 Suicide & Crisis Lifeline, available 24/7.',
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'CBT for Depression', href: '/approach/cbt/for-depression' },
      { label: 'ACT for Depression', href: '/approach/act/for-depression' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
