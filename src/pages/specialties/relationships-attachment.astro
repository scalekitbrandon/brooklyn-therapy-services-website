---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Relationships & Attachment Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="Attachment-focused therapy in Brooklyn and online across New York. Understand relationship patterns rooted in early attachment and build healthier ways to connect."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Relationships & Attachment Therapy in Brooklyn, NY"
    intro="Support for understanding how closeness, distance, and old patterns show up in your relationships today. Attachment-focused therapy helps you see the pattern clearly enough to change it."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Relationships & Attachment Therapy?"
    paragraphs={[
      'Attachment-focused therapy looks at how your earliest relationships shaped the way you connect, trust, and communicate now — in friendships, family, dating, and romantic partnerships.',
      "This isn't about blaming your past. It's about understanding the patterns you learned so you can respond differently in the relationships that matter to you today.",
      'Sessions typically happen weekly, in 45–50 minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs Attachment Work Might Help"
    intro="Attachment patterns show up in ways that can be hard to name. You might notice:"
    signs={[
      "You either cling tightly to relationships or pull away before you can get hurt",
      "You struggle to trust people, even when they've given you no reason not to",
      'You feel anxious when a partner or friend pulls back, even briefly',
      'You avoid depending on others, even when you need support',
      'You keep choosing similar dynamics in different relationships',
      'You want to understand your patterns instead of just reacting to them',
    ]}
    note="These patterns usually made sense once — they kept you safe growing up. Therapy helps you recognize when they're still helping, and when they're just getting in the way."
  />

  <ProseSection
    heading="Our Approach to Relationships & Attachment"
    paragraphs={[
      'We use attachment theory as a lens for understanding your relational patterns, paired with <a href="/approach/psychodynamic">psychodynamic</a> work to explore where they came from and what keeps them going.',
      "The goal isn't to erase your instincts — it's to give you more choice in how you respond, so closeness and independence stop feeling like opposites.",
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Relationships & Attachment"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with particular attention to relationship difficulties and relational patterns.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is this the same as couples therapy?',
        answer: 'Not exactly — this work focuses on your individual attachment patterns and how they show up across relationships, rather than working with you and a partner together. Many clients do this work before or alongside couples therapy.',
      },
      {
        question: 'Can attachment patterns actually change?',
        answer: 'Yes. While early patterns are deeply ingrained, they are not fixed. With consistent work, most people can build more secure ways of relating over time.',
      },
      {
        question: 'Do I need to understand my childhood to do this work?',
        answer: 'Some exploration of early relationships is usually helpful, but the focus stays practical — on how patterns show up in your life now, not just analyzing the past for its own sake.',
      },
      {
        question: 'How long does this kind of work take?',
        answer: 'Attachment patterns typically take longer than a single presenting issue to shift meaningfully — many clients work on this over several months to a year, sometimes alongside other goals.',
      },
      {
        question: 'Do you offer this work online?',
        answer: 'Yes — sessions are available online for clients anywhere in New York.',
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'IFS for Relationships', href: '/approach/ifs/for-relationships' },
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
