---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Sex & Intimacy Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="Therapy for sex and intimacy concerns in Brooklyn and online across New York. A judgment-free space to work through desire, disconnection, and relational intimacy."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Sex & Intimacy Therapy in Brooklyn, NY"
    intro="Support for the parts of intimacy that are hardest to talk about — desire, disconnection, shame, and everything in between. Sex and intimacy therapy makes room for honest conversation, without judgment."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Sex & Intimacy Therapy?"
    paragraphs={[
      "Sex and intimacy therapy addresses concerns around desire, connection, and physical or emotional closeness — whether you're working through this individually or with a partner.",
      'This is talk therapy, not physical treatment — the focus is on the emotional, relational, and psychological factors that shape your experience of intimacy.',
      'Sessions typically happen weekly, in 50-minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs This Work Might Help"
    intro="These conversations can be hard to start. You might be a fit for this work if:"
    signs={[
      "Desire or interest in intimacy has changed and you're not sure why",
      'You feel disconnected from a partner physically, even when things are otherwise fine',
      'Shame or discomfort makes it hard to talk about sex, even with people you trust',
      'Past experiences affect how safe or present you feel during intimacy',
      "You and a partner want different things and aren't sure how to talk about it",
      'You want a private space to understand your own relationship to intimacy',
    ]}
    note="These conversations are rarely just about sex — they usually touch on trust, safety, and how seen you feel. Therapy makes room for all of that."
  />

  <ProseSection
    heading="Our Approach to Sex & Intimacy"
    paragraphs={[
      'We draw on <a href="/approach/psychodynamic">psychodynamic</a> principles, exploring how shame, past experiences, and communication patterns shape your experience of desire and closeness.',
      'Sessions are collaborative and paced by you — there is no script, and no topic is off-limits or too small to bring in.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Sex & Intimacy"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — creating a safe, judgment-free space to explore intimacy and connection.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care that makes room for hard-to-discuss topics like intimacy and connection.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is this couples therapy or individual therapy?',
        answer: 'Either — we work with individuals exploring their own relationship to intimacy, and with couples navigating these issues together.',
      },
      {
        question: "Do I need to give details I'm not comfortable sharing?",
        answer: 'No. You share only what feels right, at your own pace. This work is collaborative, not clinical interrogation.',
      },
      {
        question: 'Is this therapy or sex therapy specifically?',
        answer: 'This is talk therapy addressing the emotional and relational side of intimacy — not physical or medical treatment. If a medical concern is involved, we can help connect you with the right specialist alongside this work.',
      },
      {
        question: 'Can this help if my partner and I want different things?',
        answer: 'Yes — differing desire or needs around intimacy is one of the most common things we work through, individually or together.',
      },
      {
        question: 'Do you offer this online?',
        answer: 'Yes, available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
