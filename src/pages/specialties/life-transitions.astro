---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Life Transitions Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="Therapy for major life transitions in Brooklyn and online across New York. Navigate change, uncertainty, and identity shifts with grounded, practical support."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Life Transitions Therapy in Brooklyn, NY"
    intro="Support for the moments when everything is changing — a breakup, a move, a career shift, a new chapter you didn't expect. Therapy for life transitions helps you find footing while things are still in motion."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Life Transitions Therapy?"
    paragraphs={[
      "Life transitions therapy is short- to medium-term support for navigating major change — voluntary or not — when your usual coping doesn't quite fit the moment.",
      "Transitions can bring up grief, identity questions, and uncertainty even when the change itself is positive. This work helps you process what's shifting and make grounded decisions instead of reactive ones.",
      'Sessions typically happen weekly, in 50-minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs Transition Support Might Help"
    intro="Not every transition needs support, but many benefit from it. You might be a fit if:"
    signs={[
      'You are facing a major change — career, relationship, location, or identity',
      'You feel unmoored, like the ground you used to stand on has shifted',
      'You are making a big decision and want a clearer head to make it with',
      "Old coping strategies aren't working for this new chapter",
      'You feel grief or loss around something that ended, even if the change is good',
      'You want support building a new sense of direction',
    ]}
    note="Transitions rarely announce themselves as hard — they just quietly take up all your bandwidth. Therapy gives that bandwidth somewhere to go."
  />

  <ProseSection
    heading="Our Approach to Life Transitions"
    paragraphs={[
      'We combine <a href="/approach/act">ACT</a>-based tools for tolerating uncertainty with a <a href="/approach/psychodynamic">psychodynamic</a> lens for understanding what the transition is bringing up emotionally.',
      'The work is practical and grounded — helping you make decisions and build stability, while also making space for whatever grief, fear, or excitement the change surfaces.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Life Transitions"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with experience helping clients through major life transitions.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for life transitions alongside anxiety, depression, and grief.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is this different from regular individual therapy?',
        answer: "It's closely related — transitions work is really individual therapy with a specific focus on the change you're navigating. If new issues come up, we can widen the focus together.",
      },
      {
        question: 'What if my transition is a good thing, like a promotion or a wedding?',
        answer: "Positive transitions can still bring stress, identity shifts, and grief for what's changing. You don't need something to be 'bad' to benefit from support through it.",
      },
      {
        question: 'How long does this kind of work usually take?',
        answer: "Many clients work through a specific transition in a few months, though some stay longer if new goals emerge. We'll check in on this together.",
      },
      {
        question: 'Can you help me make a decision, like whether to leave a job or relationship?',
        answer: 'We will not make the decision for you, but we can help you get clear on your values and fears so the decision feels more like yours and less like guesswork.',
      },
      {
        question: 'Do you offer online sessions for this?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
