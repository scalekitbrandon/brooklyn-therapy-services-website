---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Trauma & PTSD Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="Trauma-informed therapy in Brooklyn and online across New York. Process trauma and PTSD symptoms at your own pace with psychodynamic and CBT-based care."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Trauma & PTSD Therapy in Brooklyn, NY"
    intro="Support for experiences that continue to shape how safe, present, and connected you feel. Trauma and PTSD therapy at Brooklyn Therapy Services helps you process what happened — without having to relive it alone."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Trauma & PTSD Therapy?"
    paragraphs={[
      'Trauma therapy is focused support for processing experiences — whether a single event or prolonged exposure — that continue to affect your nervous system, relationships, and sense of safety long after they happened.',
      "PTSD and trauma responses can show up as hypervigilance, flashbacks, avoidance, emotional numbness, or a persistent feeling that something is wrong even when you're safe. Treatment focuses on helping your nervous system recognize the difference between then and now.",
      'Sessions typically happen weekly, in 45–50 minute sessions, either in person in Brooklyn or online across New York, and always move at a pace that feels safe for you.',
    ]}
  />

  <SignsList
    heading="Signs Trauma Therapy Might Help"
    intro="Trauma responses don't always look like what you'd expect. You might be a fit for this work if:"
    signs={[
      'You feel on edge or hypervigilant, even in situations that are objectively safe',
      'Certain memories, places, or triggers bring on intense emotional or physical reactions',
      "You feel emotionally numb, disconnected, or 'checked out' much of the time",
      'Past experiences keep showing up in how you relate to others now',
      'You avoid people, places, or conversations that remind you of what happened',
      "You're ready to process something you've been carrying alone",
    ]}
    note="These responses often show up in ways that don't feel connected to the past at all. Therapy helps your nervous system catch up to the fact that you're safe now."
  />

  <ProseSection
    heading="Our Approach to Trauma & PTSD"
    paragraphs={[
      'We use a <a href="/approach/psychodynamic">psychodynamic</a> and attachment-informed lens to understand how trauma has shaped your patterns, combined with <a href="/approach/cbt">CBT</a> and <a href="/approach/act">ACT</a>-based tools for managing symptoms in daily life.',
      "Above all, the pace is yours. We won't ask you to relive or dive into anything before you feel ready — safety and stabilization come first, always.",
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Trauma & PTSD"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Particular experience working with complex trauma and PTSD, using an integrative blend of psychodynamic work, ACT, and CBT.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Do I have to talk about the traumatic event in detail?',
        answer: 'No. We move at your pace, and processing trauma does not require reliving every detail. Much of the work focuses on how the experience shows up now — in your body, relationships, and daily life.',
      },
      {
        question: "What's the difference between trauma and PTSD?",
        answer: 'Trauma refers to a distressing experience; PTSD is a specific diagnosis involving persistent symptoms like flashbacks, avoidance, and hyperarousal following trauma. You do not need a PTSD diagnosis to benefit from trauma-focused therapy.',
      },
      {
        question: 'How long does trauma therapy take?',
        answer: "It varies significantly based on the nature and complexity of what you're processing. Some clients see meaningful relief within months; more complex or longstanding trauma may take longer. We'll check in on progress regularly.",
      },
      {
        question: "Is trauma therapy only for 'big' traumatic events?",
        answer: "No. Trauma responses can develop from a single event or from prolonged, cumulative experiences — including ones that might not seem 'big enough' to count. If it's affecting you, it's worth addressing.",
      },
      {
        question: 'Do you offer online trauma therapy?',
        answer: 'Yes — secure video sessions are available for clients anywhere in New York.',
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'IFS for Trauma', href: '/approach/ifs/for-trauma' },
      { label: 'IFS for PTSD', href: '/approach/ifs/for-ptsd' },
      { label: 'IFS for Complex Trauma', href: '/approach/ifs/for-complex-trauma' },
      { label: 'IFS for Childhood Trauma', href: '/approach/ifs/for-childhood-trauma' },
      { label: 'ACT for Trauma', href: '/approach/act/for-trauma' },
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
