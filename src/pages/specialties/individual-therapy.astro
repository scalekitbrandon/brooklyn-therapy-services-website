---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Individual Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="One-on-one therapy for adults in Brooklyn and across New York. Evidence-based, relational care for anxiety, life transitions, and longstanding patterns."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Individual Therapy in Brooklyn, NY"
    intro="One-on-one support for adults navigating anxiety, life transitions, and the patterns that keep showing up. Individual therapy at Brooklyn Therapy Services is a space built around you — your pace, your goals, your story."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Individual Therapy?"
    paragraphs={[
      "Individual therapy is a one-on-one relationship between you and a licensed therapist, focused entirely on what you're working through — whether that's anxiety, a difficult transition, a relationship pattern, or something harder to name.",
      "Unlike advice from friends or family, therapy offers a structured, confidential space with someone trained to help you understand not just what's happening, but why it keeps happening — and what to do differently.",
      'Sessions typically happen weekly, in 45–50 minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs Individual Therapy Might Help"
    intro="You don't need a crisis to start therapy. Many people begin individual therapy because:"
    signs={[
      "You feel anxious, overwhelmed, or stuck more often than not",
      "You're going through a major life change — a breakup, a career shift, a move",
      'You keep running into the same patterns in relationships or at work',
      'You want an unbiased space to think out loud',
      "You're managing grief, trauma, or something you haven't fully processed",
      'You simply want to understand yourself better',
    ]}
    note="These patterns often show up quietly, over months or years. Therapy makes room to notice them — and start choosing something different."
  />

  <ProseSection
    heading="Our Approach to Individual Therapy"
    paragraphs={[
      'We draw from <a href="/approach/psychodynamic">psychodynamic therapy</a>, <a href="/approach/act">Acceptance and Commitment Therapy (ACT)</a>, and <a href="/approach/cbt">Cognitive Behavioral Therapy (CBT)</a> — blending insight-oriented work with practical, actionable tools.',
      'Rather than treating symptoms in isolation, we focus on the emotional and relational patterns underneath them, so change lasts beyond the session.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Individual Therapy"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with particular depth in OCD, anxiety, and trauma.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for anxiety, depression, grief, and life transitions.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'How long does individual therapy take?',
        answer: "There's no fixed timeline — some clients come for a few months to work through a specific issue, others stay longer for ongoing support. We check in regularly on your goals and progress.",
      },
      {
        question: 'Is individual therapy covered by insurance?',
        answer: 'We can provide a superbill for out-of-network reimbursement. Reach out and we can walk you through your specific plan.',
      },
      {
        question: 'Do you offer online individual therapy?',
        answer: 'Yes — all of our therapists offer secure video sessions for clients located anywhere in New York.',
      },
      {
        question: 'How do I know if individual therapy is right for me?',
        answer: "If you're dealing with anxiety, a difficult transition, or patterns you want to understand and shift, individual therapy is a strong fit. A free consultation can help confirm it's the right step.",
      },
      {
        question: 'What happens in a first session?',
        answer: "We'll talk through what brought you in, your history, and what you're hoping to get out of therapy — and make sure it feels like the right fit on both sides.",
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'ACT for Depression', href: '/approach/act/for-depression' },
      { label: 'CBT for Depression', href: '/approach/cbt/for-depression' },
      { label: 'ACT for Perfectionism', href: '/approach/act/for-perfectionism' },
      { label: 'CBT for Insomnia', href: '/approach/cbt/for-insomnia' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
