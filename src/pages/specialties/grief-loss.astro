---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Grief & Loss Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="Grief therapy in Brooklyn and online across New York. Compassionate, unhurried support for mourning, loss, and everything that comes with it."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Grief & Loss Therapy in Brooklyn, NY"
    intro="Support for mourning, loss, and the process of learning to carry what's changed. Grief therapy at Brooklyn Therapy Services makes room for grief on its own timeline — not anyone else's."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Grief & Loss Therapy?"
    paragraphs={[
      'Grief therapy is support for processing loss — of a person, a relationship, a role, or a version of life you expected to have.',
      "Grief doesn't move in a straight line, and there's no timeline you're supposed to be following. This work makes space for whatever grief looks like for you, without rushing you toward 'moving on.'",
      'Sessions typically happen weekly, in 50-minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs Grief Support Might Help"
    intro="Grief can show up in unexpected ways. You might be a fit for this work if:"
    signs={[
      "You're grieving a loss and feel like you should be 'further along' than you are",
      'Grief comes in waves that catch you off guard, long after the loss',
      'You are mourning something less visible — a relationship, an identity, a future you expected',
      'You feel guilty about how you are grieving, or not grieving',
      'People around you seem ready to move on before you are',
      "You want space to grieve without managing anyone else's feelings about it",
    ]}
    note="There's no correct way to grieve, and no deadline for it either. Therapy makes room for grief exactly as it shows up for you."
  />

  <ProseSection
    heading="Our Approach to Grief & Loss"
    paragraphs={[
      'We hold space for grief without pathologizing it — this is a natural response to loss, not a problem to be fixed quickly.',
      'Using a <a href="/approach/psychodynamic">psychodynamic</a> and relational lens, we help you process what has been lost while finding ways to carry it that do not require you to leave it — or yourself — behind.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Grief & Loss"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with experience supporting clients through grief and loss.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for grief alongside anxiety, depression, and life transitions.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'How soon after a loss should I start therapy?',
        answer: 'Whenever feels right to you — some people begin right away, others wait months or years. There is no wrong time to start.',
      },
      {
        question: "What if my grief isn't about a death?",
        answer: 'Grief applies to any significant loss — a breakup, a job, your health, or a future you expected. All of it is valid to bring into this work.',
      },
      {
        question: 'Will therapy make the grief go away?',
        answer: 'No, and that is not the goal. The goal is to help you carry the loss in a way that lets you keep living fully alongside it.',
      },
      {
        question: 'How long does grief therapy typically last?',
        answer: "It varies widely — some clients come for a few months around a specific loss, others longer if grief connects to other patterns. We'll follow your pace.",
      },
      {
        question: 'Do you offer online grief support?',
        answer: 'Yes — sessions are available online for clients anywhere in New York.',
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
