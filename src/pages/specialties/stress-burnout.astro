---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Stress & Burnout Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="Therapy for chronic stress and burnout in Brooklyn and online across New York. Rebuild capacity and boundaries with practical, evidence-based support."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Stress & Burnout Therapy in Brooklyn, NY"
    intro="Support for chronic stress and the exhaustion of doing too much for too long. Therapy for stress and burnout helps you rebuild capacity — not just push through."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Stress & Burnout Therapy?"
    paragraphs={[
      'Stress and burnout therapy addresses the toll of chronic overwork, overwhelm, or emotional depletion — whether it is coming from your job, caregiving, or simply carrying too much for too long.',
      "Burnout isn't a personal failing or a sign you need to 'toughen up' — it's a predictable response to sustained pressure without enough recovery. This work focuses on both immediate relief and the deeper patterns that led here.",
      'Sessions typically happen weekly, in 50-minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs Burnout Support Might Help"
    intro="Burnout often builds quietly before it becomes undeniable. You might be a fit for this work if:"
    signs={[
      "You feel exhausted even after rest, like recovery isn't really happening",
      'Work or responsibilities that used to feel manageable now feel impossible',
      'You have become cynical, detached, or numb about things you used to care about',
      'You struggle to set boundaries, even when you are at capacity',
      'Physical symptoms — headaches, tension, poor sleep — are showing up alongside the stress',
      "You know something needs to change but can't find the bandwidth to figure out what",
    ]}
    note="Burnout rarely resolves with a vacation alone — it usually points to patterns worth understanding. Therapy makes room to slow down enough to see them."
  />

  <ProseSection
    heading="Our Approach to Stress & Burnout"
    paragraphs={[
      'We combine practical, <a href="/approach/cbt">CBT</a> and <a href="/approach/act">ACT</a>-based tools for managing stress day-to-day with deeper exploration of the patterns — perfectionism, overfunctioning, difficulty saying no — that make burnout more likely.',
      'The goal is not just to help you cope better with an unsustainable pace. It is to help you build a relationship with work and rest that actually holds up.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Stress & Burnout"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — helping clients rebuild capacity after chronic stress and overwhelm.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for the exhaustion and overwhelm that come with chronic stress and burnout.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: "Isn't burnout just something I need to push through?",
        answer: 'No — pushing through is usually what led here. Sustainable change requires addressing the underlying patterns, not just gritting your teeth harder.',
      },
      {
        question: "Can therapy help if I can't change my job or workload right now?",
        answer: 'Yes. While changing external circumstances can help, this work also focuses on your relationship to stress, boundaries, and rest — things within your control regardless of the job itself.',
      },
      {
        question: 'How is this different from general anxiety therapy?',
        answer: 'There is overlap, but burnout work focuses specifically on chronic overextension and depletion, often tied to work or caregiving, rather than anxiety more broadly.',
      },
      {
        question: 'How long does this typically take?',
        answer: 'Many clients see meaningful relief within a few months, especially when paired with concrete changes to boundaries and routines. Others continue longer to address root patterns.',
      },
      {
        question: 'Do you offer online sessions for this?',
        answer: 'Yes — available anywhere in New York via secure video, which many clients managing demanding schedules prefer.',
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'ACT for Stress', href: '/approach/act/for-stress' },
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
