---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import SpecialtyIndexGrid from '../../components/SpecialtyIndexGrid.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Therapy Services in Brooklyn, NY | Brooklyn Therapy Services"
  description="Individual and couples therapy in Brooklyn and online across New York. Explore our specialties — anxiety, trauma, relationships, grief, and more."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Therapy Services in Brooklyn, NY"
    intro="Individual and couples therapy for the specific thing you're navigating — not a one-size-fits-all approach. Explore our specialties below, or reach out and we'll help you find the right fit."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialtyIndexGrid
    heading="Explore Our Specialties"
    items={[
      {
        title: 'Individual Therapy',
        description: "Working through what's weighing on you, at your own pace, in a space that's just yours.",
        href: '/specialties/individual-therapy',
        icon: 'lamppost',
      },
      {
        title: 'Couples Therapy',
        description: 'Rebuilding communication, trust, and connection with the person you share your life with.',
        href: '/specialties/couples-therapy',
        icon: 'twinChairs',
      },
      {
        title: 'Anxiety',
        description: 'Understanding intrusive thoughts, hypervigilance, and internal pressure cycles.',
        href: '/specialties/anxiety',
        icon: 'waterTower',
      },
      {
        title: 'OCD',
        description: 'ERP-based treatment for obsessions, compulsions, and certainty-seeking cycles.',
        href: '/specialties/ocd',
        icon: 'streetClock',
      },
      {
        title: 'Trauma & PTSD',
        description: 'Processing experiences that continue to shape emotional safety and connection.',
        href: '/specialties/trauma-ptsd',
        icon: 'bridgeTowers',
      },
      {
        title: 'Relationships & Attachment',
        description: 'Exploring how closeness, distance, and repetition show up in connection.',
        href: '/specialties/relationships-attachment',
        icon: 'rowhouse',
      },
      {
        title: 'Life Transitions',
        description: 'Supporting periods of change, uncertainty, or identity shifts.',
        href: '/specialties/life-transitions',
        icon: 'subway',
      },
      {
        title: 'Sex & Intimacy',
        description: 'Working through shame, desire, disconnection, and relational intimacy concerns.',
        href: '/specialties/sex-intimacy',
        icon: 'ferry',
      },
      {
        title: 'Grief & Loss',
        description: 'Holding space for mourning, loss, and the slow process of learning to carry it.',
        href: '/specialties/grief-loss',
        icon: 'tree',
      },
      {
        title: 'Stress & Burnout',
        description: 'Recognizing chronic stress and the toll of doing too much for too long.',
        href: '/specialties/stress-burnout',
        icon: 'fireEscape',
      },
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <FaqAccordion
    faqs={[
      {
        question: 'How do I know which specialty is right for me?',
        answer: "You don't have to figure it out alone — a free 15-minute consultation is the easiest way to talk through what you're navigating and get matched with the right therapist and approach.",
      },
      {
        question: 'Do you accept insurance?',
        answer: 'We are out-of-network providers and can supply a superbill for reimbursement. Reach out and we can walk you through what that looks like for your specific plan.',
      },
      {
        question: 'Do you offer both in-person and online sessions?',
        answer: 'Yes — we see clients in person in Brooklyn and online for anyone located across New York.',
      },
      {
        question: "What if my concern isn't listed here?",
        answer: 'Our specialties reflect the areas we most commonly work with, but they are not exhaustive. Reach out and we can let you know if we are a good fit, or offer a referral if we are not.',
      },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
