---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Anxiety Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="Anxiety therapy in Brooklyn and online across New York. CBT and ACT-based care for worry, panic, and hypervigilance."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Anxiety Therapy in Brooklyn, NY"
    intro="Support for the intrusive worry, restlessness, and hypervigilance that keep your nervous system stuck in overdrive. Anxiety therapy at Brooklyn Therapy Services helps you understand the cycle — and start to interrupt it."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Anxiety Therapy?"
    paragraphs={[
      'Anxiety therapy is focused, evidence-based treatment for the excessive worry, panic, and hypervigilance that can take over daily life.',
      'Using primarily <a href="/approach/cbt">CBT</a> and <a href="/approach/act">ACT</a>, the work centers on understanding what is driving the anxiety response — and building a different relationship with anxious thoughts, rather than just trying to suppress them. Looking for OCD-specific treatment instead? Visit our <a href="/specialties/ocd">OCD therapy page</a>.',
      'Sessions typically happen weekly, in 50-minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs Anxiety Therapy Might Help"
    intro="Anxiety can look different for everyone. You might be a fit for this work if:"
    signs={[
      'Your mind gets stuck on the same worries, no matter how much you try to reason your way out',
      'You feel keyed up, on edge, or unable to relax even when nothing is technically wrong',
      'Panic or physical anxiety symptoms show up unexpectedly',
      'Anxiety is interfering with work, relationships, or daily routines',
      "You avoid situations, people, or decisions because of anxious 'what ifs'",
      'You are exhausted from trying to control or eliminate anxiety altogether',
    ]}
    note="Anxiety often feels like it's protecting you from something. Treatment isn't about eliminating it entirely — it's about loosening its grip on your choices."
  />

  <ProseSection
    heading="Our Approach to Anxiety"
    paragraphs={[
      'We draw heavily from <a href="/approach/cbt">Cognitive Behavioral Therapy (CBT)</a> and <a href="/approach/act">Acceptance and Commitment Therapy (ACT)</a> — approaches with strong evidence for treating anxiety.',
      'Rather than fighting or avoiding anxious thoughts, we work on changing your relationship to them, building tolerance for uncertainty so anxiety has less control over your choices.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Anxiety"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Particular experience working with severe anxiety, using an integrative blend of psychodynamic work, ACT, and CBT.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for anxiety alongside depression, grief, and life transitions.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Do you use exposure-based techniques for anxiety?',
        answer: 'Yes, when appropriate — particularly for specific phobias or panic, we may incorporate gradual exposure principles alongside ACT and CBT.',
      },
      {
        question: 'How long does anxiety therapy take?',
        answer: "It depends on severity and goals. Some clients see meaningful shifts within a few months of consistent work; others continue longer. We'll set a plan together early on.",
      },
      {
        question: "Can anxiety therapy help even if I don't have a diagnosis?",
        answer: 'Yes. You do not need a formal diagnosis to benefit — many people come in simply because anxiety is getting in the way of their life.',
      },
      {
        question: 'Do you offer online therapy for anxiety?',
        answer: 'Yes — we offer online anxiety therapy for clients located anywhere in New York, in addition to in-person sessions in Brooklyn.',
      },
      {
        question: 'Is this different from OCD treatment?',
        answer: 'Related but distinct — general anxiety therapy uses CBT and ACT, while OCD specifically responds best to ERP (Exposure and Response Prevention). Visit our OCD therapy page if that is a closer fit.',
        answerHtml: 'Related but distinct — general anxiety therapy uses CBT and ACT, while OCD specifically responds best to <a href="/approach/erp">ERP (Exposure and Response Prevention)</a>. Visit our <a href="/specialties/ocd">OCD therapy page</a> if that is a closer fit.',
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'CBT for Anxiety', href: '/approach/cbt/for-anxiety' },
      { label: 'CBT for Panic Attacks', href: '/approach/cbt/for-panic-attacks' },
      { label: 'CBT for Social Anxiety', href: '/approach/cbt/for-social-anxiety' },
      { label: 'ACT for Anxiety', href: '/approach/act/for-anxiety' },
      { label: 'IFS for Anxiety', href: '/approach/ifs/for-anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
