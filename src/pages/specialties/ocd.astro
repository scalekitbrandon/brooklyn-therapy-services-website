---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="OCD Therapist in Brooklyn, NY | Brooklyn Therapy Services"
  description="Work with an OCD therapist in Brooklyn for ERP-based treatment — in person or through online OCD therapy across New York."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="OCD Therapist in Brooklyn, NY"
    intro="Work with an OCD therapist in Brooklyn who treats obsessive-compulsive disorder with ERP (Exposure and Response Prevention) — the gold-standard, evidence-based approach for breaking the cycle of intrusive thoughts and compulsions."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is OCD?"
    paragraphs={[
      'Obsessive-compulsive disorder (OCD) involves unwanted, intrusive thoughts (obsessions) that create intense anxiety, paired with rituals or mental acts (compulsions) aimed at relieving that anxiety — checking, counting, reassurance-seeking, mental reviewing, and more.',
      'OCD is highly treatable, but talk therapy alone often is not enough. The most effective treatment is <a href="/approach/erp">ERP (Exposure and Response Prevention)</a>, sometimes combined with <a href="/approach/act">ACT</a> or <a href="/approach/cbt">CBT</a> for additional support.',
      'Sessions typically happen weekly, in 50-minute sessions — in person in our Brooklyn office, or through online OCD therapy for clients anywhere in New York.',
    ]}
  />

  <SignsList
    heading="Signs You May Be Dealing With OCD"
    intro="OCD can look different from person to person. You might be a fit for OCD-focused treatment if:"
    signs={[
      "Intrusive thoughts loop endlessly, no matter how much you try to reason your way out of them",
      "You check, count, wash, or repeat actions to relieve anxiety, even when it doesn't make logical sense",
      'You seek constant reassurance from others or from yourself',
      'Avoidance has taken over — certain places, objects, or situations feel impossible to face',
      "Mental rituals (replaying, reviewing, 'undoing' a thought) take up significant time",
      'OCD is interfering with work, relationships, or daily functioning',
    ]}
    note="OCD thrives on certainty-seeking. Treatment isn't about eliminating the thoughts — it's about changing your relationship to the uncertainty underneath them."
  />

  <ProseSection
    heading="Our Approach to OCD"
    paragraphs={[
      'Our primary treatment for OCD is <a href="/approach/erp">ERP (Exposure and Response Prevention)</a> — the most well-supported, evidence-based treatment available. We build an exposure plan together, always starting with what feels manageable.',
      'We often combine ERP with <a href="/approach/act">ACT</a> principles, helping you build tolerance for uncertainty and discomfort rather than seeking to eliminate it.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in OCD"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Particular experience working with OCD and severe anxiety, using ERP alongside ACT and CBT.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is OCD just about being clean and organized?',
        answer: "No — that's a common misconception. OCD can center on almost any theme (harm, contamination, relationships, morality, symmetry) and often has nothing to do with cleanliness.",
      },
      {
        question: 'What is the most effective treatment for OCD?',
        answer: 'ERP (Exposure and Response Prevention) is considered the gold-standard, most well-researched treatment for OCD, often combined with ACT or CBT.',
        answerHtml: '<a href="/approach/erp">ERP (Exposure and Response Prevention)</a> is considered the gold-standard, most well-researched treatment for OCD, often combined with <a href="/approach/act">ACT</a> or <a href="/approach/cbt">CBT</a>.',
      },
      {
        question: 'Can OCD be treated without medication?',
        answer: 'Yes, ERP alone is effective for many people. Some clients also work with a prescriber for medication alongside therapy — we can discuss what makes sense for you.',
      },
      {
        question: 'How long does OCD treatment typically take?',
        answer: 'Many clients see meaningful symptom reduction within a few months of consistent ERP work, though this depends on severity and the specific themes involved.',
      },
      {
        question: 'Do you offer online OCD therapy in New York?',
        answer: 'Yes — we offer online OCD therapy for clients located anywhere in New York, in addition to in-person sessions with an OCD therapist in Brooklyn.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Treatment & Specialties"
    items={[
      { label: 'ERP (Our Treatment for OCD)', href: '/approach/erp' },
      { label: 'CBT for OCD', href: '/approach/cbt/for-ocd' },
      { label: 'ACT for OCD', href: '/approach/act/for-ocd' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
