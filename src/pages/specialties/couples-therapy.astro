---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Couples Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="Couples therapy in Brooklyn and online across New York. Rebuild communication, trust, and connection with evidence-based, relational care."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Couples Therapy in Brooklyn, NY"
    intro="Support for partners who want to communicate better, rebuild trust, or simply feel more connected. Couples therapy at Brooklyn Therapy Services is a space to slow down together and work through what's getting in the way."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is Couples Therapy?"
    paragraphs={[
      'Couples therapy brings both partners into the room together with a licensed therapist to work through conflict, communication breakdowns, or a sense of drifting apart.',
      "It's not about assigning blame or deciding who's right — it's about understanding the patterns that keep showing up between you, and building new ways of relating that actually work for both of you.",
      'Sessions typically happen weekly, in 50-minute sessions, either in person in Brooklyn or online across New York.',
    ]}
  />

  <SignsList
    heading="Signs Couples Therapy Might Help"
    intro="Couples don't need to be in crisis to benefit from therapy. Many partners come in because:"
    signs={[
      'You keep having the same argument, just with different words',
      "Communication feels harder than it used to — or like you're speaking different languages",
      "Trust has been broken and you're not sure how to rebuild it",
      "You've drifted apart and want to feel close again",
      "You're navigating a major transition together — a move, a baby, a loss",
      'You want tools to fight fair and repair faster',
    ]}
    note="These patterns often build gradually, without either partner intending them. Therapy makes room to notice them together — and start choosing something different."
  />

  <ProseSection
    heading="Our Approach to Couples Therapy"
    paragraphs={[
      'We work relationally — looking at the attachment patterns and communication cycles that shape how you and your partner show up for each other, for better or worse.',
      'Sessions blend structured, <a href="/approach/cbt">CBT-based</a> communication tools with deeper, <a href="/approach/psychodynamic">psychodynamic</a> insight-oriented work, so you leave with both practical skills and a real understanding of what has been driving the conflict.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Specialize in Couples Therapy"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with particular experience helping couples navigate relationship difficulties and major life transitions.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Do both partners need to attend every session?',
        answer: "Most sessions include both partners together, though we may occasionally suggest an individual session if it would help the work. We'll always discuss this with you first.",
      },
      {
        question: 'What if my partner is hesitant about therapy?',
        answer: 'That\'s common — many people feel unsure at first. A free consultation can help address concerns and make the process feel less intimidating before committing to ongoing sessions.',
      },
      {
        question: "Can couples therapy help even if we're not in crisis?",
        answer: 'Yes. Many couples come in for maintenance — to strengthen communication, deepen intimacy, or navigate a transition — not just to repair something broken.',
      },
      {
        question: 'Do you offer online couples therapy?',
        answer: 'Yes — couples across New York can meet with us via secure video sessions, which also works well if partners have different schedules or locations.',
      },
      {
        question: 'How long does couples therapy typically take?',
        answer: "It varies widely depending on your goals — some couples see meaningful shifts in a few months, others continue longer-term. We'll set goals together early on and revisit them regularly.",
      },
    ]}
  />

  <RelatedSpecialties
    items={[
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
