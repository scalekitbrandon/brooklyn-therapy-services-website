---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Philosophy from '../components/Philosophy.astro';
import HowItWorks from '../components/HowItWorks.astro';
import AreasOfFocus from '../components/AreasOfFocus.astro';
import Founder from '../components/Founder.astro';
import ContactCta from '../components/ContactCta.astro';
import Footer from '../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Brooklyn Therapy Services"
  description="Therapy for the modern person. Serving adults, couples, and families across New York and New Jersey."
>
  <Header slot="header" />

  <Hero
    headline="Therapy for the Modern New Yorker."
    subhead="Personalized therapy for adults and couples — in person in Brooklyn and online across New York."
    primaryLabel="Book a Consultation"
    primaryHref="/#consultation-form"
    videoSrc="/videos/hero-bg.mp4"
  />

  <Philosophy
    eyebrow="Our Approach"
    statement="Therapy shouldn't feel like one more thing on your to-do list. It should feel like the one hour of your week that's actually yours."
    supporting="We blend evidence-based methods with real, unscripted conversation — because lasting change happens when you feel safe enough to be honest."
    linkLabel="Meet Our Team"
    linkHref="/team"
  />

  <AreasOfFocus
    eyebrow="Areas of Focus"
    heading="What We Help With"
    areas={[
      {
        title: 'Individual Therapy',
        description: "Working through what's weighing on you, at your own pace, in a space that's just yours.",
        icon: 'lamppost',
      },
      {
        title: 'Couples Therapy',
        description: 'Rebuilding communication, trust, and connection with the person you share your life with.',
        icon: 'twinChairs',
      },
      {
        title: 'Anxiety',
        description: 'Understanding intrusive thoughts, hypervigilance, and internal pressure cycles.',
        icon: 'waterTower',
      },
      {
        title: 'OCD',
        description: 'ERP-based treatment for obsessions, compulsions, and certainty-seeking cycles.',
        icon: 'streetClock',
      },
      {
        title: 'Trauma & PTSD',
        description: 'Processing experiences that continue to shape emotional safety and connection.',
        icon: 'bridgeTowers',
      },
      {
        title: 'Relationships & Attachment Patterns',
        description: 'Exploring how closeness, distance, and repetition show up in connection.',
        icon: 'rowhouse',
      },
      {
        title: 'Life Transitions',
        description: 'Supporting periods of change, uncertainty, or identity shifts.',
        icon: 'subway',
      },
      {
        title: 'Sex & Intimacy',
        description: 'Working through shame, desire, disconnection, and relational intimacy concerns.',
        icon: 'ferry',
      },
      {
        title: 'Grief & Loss',
        description: 'Holding space for mourning, loss, and the slow process of learning to carry it.',
        icon: 'tree',
      },
      {
        title: 'Stress & Burnout',
        description: 'Recognizing chronic stress and the toll of doing too much for too long.',
        icon: 'fireEscape',
      },
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="/#consultation-form"
  />

  <Founder
    heading="Meet the Founder"
    intro="<strong>I'm Rachel Vetter, a Licensed Clinical Social Worker and founder of Brooklyn Therapy Services.</strong> I graduated from Fordham University's Graduate School of Social Service and have spent 13 years helping individuals and couples better understand themselves, their relationships, and the patterns that shape their lives."
    paragraphs={[
      "My clinical approach draws on Cognitive Behavioral Therapy (CBT), psychodynamic therapy, Internal Family Systems (IFS), Acceptance and Commitment Therapy (ACT), and Exposure and Response Prevention (ERP). My particular interest in OCD and obsessive thinking stems from seeing how the search for certainty can lead to cycles of rumination and distress. I help clients learn to tolerate uncertainty, respond differently to intrusive thoughts, and reconnect with what matters most.",
      "I also work with individuals and couples navigating relationship challenges, grief, depression, and major life transitions. My approach is warm, collaborative, and direct, combining deeper self-understanding with practical strategies to create meaningful, lasting change.",
      "My goal is to help you move beyond simply managing difficult thoughts and feelings toward building a life that feels more connected to your values, relationships, and sense of self.",
    ]}
    name="Rachel Vetter"
    credentials="LCSW"
    ctaLabel="Meet the Team"
    ctaHref="/team"
  />

  <Philosophy
    statement="The work often goes deeper than the symptom."
    supporting="Anxiety, relationship difficulties, compulsive patterns, grief, and depression rarely exist in isolation. Our work makes room for both what is happening now and the experiences and patterns underneath it."
    linkLabel="Explore Our Specialties"
    linkHref="/specialties"
    background="bg"
    texture={true}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
