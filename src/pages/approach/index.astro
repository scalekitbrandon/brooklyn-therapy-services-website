---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import SpecialtyIndexGrid from '../../components/SpecialtyIndexGrid.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="Our Approach to Therapy in Brooklyn, NY | Brooklyn Therapy Services"
  description="ACT, CBT, psychodynamic, ERP, and IFS therapy in Brooklyn and online across New York. Evidence-based and insight-oriented modalities, tailored to you."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="Our Approach to Therapy in Brooklyn, NY"
    intro="We don't believe in one-size-fits-all treatment. Depending on what you're working through, we draw from several evidence-based and insight-oriented modalities — often blending more than one within the same course of therapy."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialtyIndexGrid
    eyebrow="Our Modalities"
    heading="How We Work"
    items={[
      {
        title: 'ACT',
        description: 'Building psychological flexibility — making room for difficult thoughts and feelings while still moving toward what matters.',
        href: '/approach/act',
        icon: 'lamppost',
      },
      {
        title: 'CBT',
        description: 'Identifying and shifting the thought patterns that keep anxiety, depression, and stress in place.',
        href: '/approach/cbt',
        icon: 'subway',
      },
      {
        title: 'Psychodynamic Therapy',
        description: 'Exploring the deeper emotional patterns and past experiences shaping how you think, feel, and relate today.',
        href: '/approach/psychodynamic',
        icon: 'bridgeTowers',
      },
      {
        title: 'ERP',
        description: 'A structured, evidence-based approach for reducing OCD compulsions and anxiety-driven avoidance.',
        href: '/approach/erp',
        icon: 'waterTower',
      },
      {
        title: 'IFS',
        description: 'Understanding the different parts of yourself — and building a more compassionate relationship with all of them.',
        href: '/approach/ifs',
        icon: 'rowhouse',
      },
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Do I need to pick a specific modality before starting?',
        answer: "Not at all. We'll assess what you're working through and recommend an approach — often blending more than one — rather than asking you to choose a method upfront.",
      },
      {
        question: 'What is the difference between these approaches?',
        answer: 'Broadly, CBT and ACT are more structured and present-focused, psychodynamic therapy explores deeper patterns and past experiences, ERP is a specific protocol for OCD, and IFS works with different internal "parts" of yourself. Many clients benefit from a blend rather than just one.',
      },
      {
        question: 'Is one modality more effective than another?',
        answer: 'It depends entirely on what you are working through and how you respond to different styles of work. We tailor the approach to you rather than applying the same method to everyone.',
      },
      {
        question: 'Do you use these approaches in both individual and couples therapy?',
        answer: 'Yes — the specific modality and how it is applied will look different depending on whether you are working with us individually or with a partner.',
      },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
