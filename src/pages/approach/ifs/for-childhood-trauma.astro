---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="IFS for Childhood Trauma in Brooklyn, NY | Brooklyn Therapy Services"
  description="IFS for childhood trauma in Brooklyn and online across New York. Work with the young, exiled parts carrying early experiences, with compassion instead of judgment."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="IFS for Childhood Trauma in Brooklyn, NY"
    intro="Childhood trauma often leaves behind young, frozen parts of you alongside protectors built to keep them safe. IFS was built with exactly this kind of work in mind."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How IFS Addresses Childhood Trauma Specifically"
    paragraphs={[
      "Experiences from childhood — when you had limited ability to understand or escape what was happening — often get carried by 'exile' parts that remain frozen at the age and understanding of the original experience. Protector parts then form around them, sometimes decades later, still working to prevent that pain from resurfacing.",
      "IFS works by helping your adult 'Self' build trust with the protectors first, then gently accessing and updating the exiled parts — giving them the safety, understanding, or information they didn't have access to at the time.",
    ]}
  />

  <SignsList
    heading="Is IFS the Right Fit for Your Childhood Trauma?"
    intro="IFS tends to be especially well-suited if:"
    signs={[
      'You notice younger, more vulnerable emotional states get triggered by adult situations',
      "Certain reactions feel disproportionate to what's actually happening now",
      'You have done trauma work before that focused on narrative and want a gentler entry point',
      'Family-of-origin dynamics still show up strongly in your adult relationships',
      'You want to understand your patterns with compassion rather than judgment',
    ]}
    note="IFS treats every part formed in childhood — even the ones that cause problems now — as having made sense at the time. That reframe is often where the healing starts."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Will I need to relive specific childhood memories in detail?',
        answer: 'Not necessarily in graphic detail — IFS focuses more on the parts carrying that experience and their current-day impact than on reconstructing a full narrative.',
      },
      {
        question: "What if I don't remember much of my childhood?",
        answer: 'That is common, and IFS can still work well — the parts and patterns are often more accessible than specific memories.',
      },
      {
        question: 'Is this different from inner child work?',
        answer: "They share some concepts, but IFS offers a more structured framework involving the full internal system of parts, not just a single 'inner child.'",
      },
      {
        question: 'How is this different from standard trauma therapy?',
        answer: 'Standard approaches often center on processing the narrative directly; IFS centers on the internal system that formed around the experience.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'IFS', href: '/approach/ifs' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'IFS for Relationships', href: '/approach/ifs/for-relationships' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
