---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="IFS for Anxiety in Brooklyn, NY | Brooklyn Therapy Services"
  description="IFS for anxiety in Brooklyn and online across New York. Understand the protector part behind your anxiety, instead of fighting it."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="IFS for Anxiety in Brooklyn, NY"
    intro="Anxiety often isn't just one feeling — it's a part of you working overtime to keep you safe. IFS helps you understand that part instead of fighting it."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How IFS Addresses Anxiety Specifically"
    paragraphs={[
      'IFS views anxiety as a protector part — one that developed to scan for danger and keep you prepared, often after experiences where being caught off guard felt unsafe. Fighting or suppressing this part tends to make it work harder, not less.',
      "Rather than trying to eliminate the anxious part, IFS helps you build a relationship with it from a calmer, more grounded 'Self' state — understanding what it's protecting you from, so it can relax its grip once it trusts that protection is no longer as urgently needed.",
    ]}
  />

  <SignsList
    heading="Is IFS the Right Fit for Your Anxiety?"
    intro="IFS tends to be a good match if:"
    signs={[
      'Your anxiety feels like it has a life of its own, separate from your other thoughts',
      'Trying to logically argue with your anxious thoughts has not worked',
      'You sense your anxiety is connected to something deeper or older than the current situation',
      'You are drawn to understanding your anxiety rather than just managing symptoms',
    ]}
    note="IFS doesn't ask you to silence your anxious part — it asks you to get curious about what it's been trying to do for you all along."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Does IFS replace CBT or ACT for anxiety?',
        answer: 'Not necessarily — some clients benefit from IFS alone, others combine it with more structured approaches like CBT or ACT.',
        answerHtml: 'Not necessarily — some clients benefit from IFS alone, others combine it with more structured approaches like <a href="/approach/cbt/for-anxiety">CBT</a> or <a href="/approach/act/for-anxiety">ACT</a>.',
      },
      {
        question: "What does it mean to talk to a 'part' of myself?",
        answer: "It's a way of externalizing and understanding a pattern or feeling as its own entity with its own perspective, rather than treating it as simply 'you' — many clients find this reduces internal conflict.",
      },
      {
        question: 'Is this a good fit for panic attacks specifically?',
        answer: 'IFS can be helpful, though for panic attacks specifically, CBT\'s interoceptive exposure techniques often provide more direct, faster symptom relief.',
        answerHtml: 'IFS can be helpful, though for panic attacks specifically, <a href="/approach/cbt/for-panic-attacks">CBT\'s interoceptive exposure techniques</a> often provide more direct, faster symptom relief.',
      },
      {
        question: 'How long does IFS work for anxiety typically take?',
        answer: "This varies significantly based on what's underneath the anxiety — some clients see shifts within months, others continue longer for deeper patterns.",
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'IFS', href: '/approach/ifs' },
      { label: 'CBT for Anxiety', href: '/approach/cbt/for-anxiety' },
      { label: 'ACT for Anxiety', href: '/approach/act/for-anxiety' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
