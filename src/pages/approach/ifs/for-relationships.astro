---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="IFS for Relationships in Brooklyn, NY | Brooklyn Therapy Services"
  description="IFS for relationship patterns in Brooklyn and online across New York. Find the protector part driving the pattern, and why it formed."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="IFS for Relationships in Brooklyn, NY"
    intro="The same relationship pattern keeps repeating — and it usually isn't random. IFS helps you find the part of you steering it, and why."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How IFS Addresses Relationship Patterns Specifically"
    paragraphs={[
      'Recurring relationship patterns — pursuing partners who pull away, shutting down during conflict, difficulty trusting even reliable people — are often driven by protector parts formed in earlier relationships, still running the same protective strategy regardless of whether the current relationship actually calls for it.',
      'IFS helps you identify which part takes over during conflict or closeness, understand what it learned to protect you from, and build enough trust with it that it can step back and let you respond to the actual person in front of you, not just the pattern.',
    ]}
  />

  <SignsList
    heading="Is IFS the Right Fit for Your Relationship Patterns?"
    intro="IFS tends to help most if:"
    signs={[
      'You notice the same dynamic repeating across different relationships',
      "You react strongly to things that seem to bother you more than they'd bother most people",
      'Part of you wants closeness while another part pulls away or shuts down',
      'You can see the pattern intellectually but keep repeating it anyway',
      "You want to understand the 'why' behind your relational patterns, not just get communication tips",
    ]}
    note="The parts driving these patterns usually formed to protect you from something real. Understanding that is often what finally allows the pattern to shift."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is this the same as couples therapy?',
        answer: 'No — this is individual work on your own patterns, though it can be done alongside couples therapy or before starting it.',
        answerHtml: 'No — this is individual work on your own patterns, though it can be done alongside <a href="/specialties/couples-therapy">couples therapy</a> or before starting it.',
      },
      {
        question: 'Why do I keep choosing similar partners or dynamics?',
        answer: 'Often a protector part is running a familiar strategy — even an unhelpful one — because it is what feels predictable, which IFS work can help identify and shift.',
      },
      {
        question: 'How is this different from attachment-focused therapy?',
        answer: 'They overlap significantly — IFS offers a specific framework of internal parts for understanding those attachment patterns.',
        answerHtml: 'They overlap significantly — IFS offers a specific framework of internal parts for understanding those <a href="/specialties/relationships-attachment">attachment patterns</a>.',
      },
      {
        question: 'How long does this kind of work typically take?',
        answer: 'Relational patterns are often longstanding, so this tends to be longer-term work — many months to over a year.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'IFS', href: '/approach/ifs' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
