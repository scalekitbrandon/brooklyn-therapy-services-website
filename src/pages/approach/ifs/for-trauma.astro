---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="IFS for Trauma in Brooklyn, NY | Brooklyn Therapy Services"
  description="IFS-based trauma therapy in Brooklyn and online across New York. Process trauma through your internal parts, without needing to relive it."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="IFS for Trauma in Brooklyn, NY"
    intro="Trauma often leaves behind 'parts' of you that got frozen in the moment it happened — IFS gives you a direct way to work with those parts instead of around them."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How IFS Addresses Trauma Specifically"
    paragraphs={[
      "IFS understands trauma responses as protective 'parts' of you — an exile carrying pain from the original experience, and protector parts (hypervigilance, numbing, avoidance) that formed to keep that pain from surfacing again.",
      "Rather than asking you to retell the traumatic event in detail, IFS works by building a relationship with these parts from a grounded, compassionate 'Self' state — often making it possible to process trauma with less overwhelm than narrative-focused approaches.",
    ]}
  />

  <SignsList
    heading="Signs IFS Might Be a Strong Fit for Your Trauma"
    intro="IFS is especially well-suited to trauma work if:"
    signs={[
      'Retelling the traumatic story in detail feels overwhelming or re-traumatizing',
      'You notice distinct parts of yourself that react very differently in different situations',
      'Protective patterns (numbing, hypervigilance, people-pleasing) feel disconnected from your sense of who you actually are',
      'Previous trauma treatment focused heavily on the narrative and felt incomplete',
      "You're drawn to a gentler, less exposure-heavy approach to processing what happened",
    ]}
    note="IFS doesn't require you to relive the trauma to heal from it — that's often exactly why it's a good fit when other approaches have felt too intense."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Do I have to talk about the traumatic event in detail with IFS?',
        answer: 'No — IFS works primarily with your internal parts and their relationship to the experience, rather than requiring a detailed narrative account.',
      },
      {
        question: "What if I don't feel like I have distinct 'parts'?",
        answer: 'That is common at first — the language of parts often becomes clearer once we start exploring specific reactions or patterns together.',
      },
      {
        question: 'Is IFS evidence-based for trauma?',
        answer: 'Yes — IFS has a growing evidence base specifically for trauma and PTSD, including recognition from trauma researchers for its gentler, parts-based approach.',
      },
      {
        question: 'How is this different from standard trauma-focused therapy?',
        answer: 'Standard approaches often center on processing the narrative directly; IFS centers on the internal system that formed around the experience, which many clients find more tolerable.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'IFS', href: '/approach/ifs' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
