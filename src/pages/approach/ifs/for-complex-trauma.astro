---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="IFS for Complex Trauma in Brooklyn, NY | Brooklyn Therapy Services"
  description="IFS for complex trauma in Brooklyn and online across New York. A gradual, safety-first approach built for the layered internal system complex trauma creates."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="IFS for Complex Trauma in Brooklyn, NY"
    intro="Complex trauma — repeated or prolonged, often relational — tends to create an intricate internal system of protectors. IFS was designed to work with exactly that complexity."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How IFS Addresses Complex Trauma Specifically"
    paragraphs={[
      'Complex trauma — trauma that was repeated, prolonged, or occurred within relationships you depended on — tends to create a more elaborate internal system than single-incident trauma: multiple exiles carrying different experiences, and multiple protectors, sometimes in conflict with each other (one part wants closeness, another distrusts it completely).',
      'IFS is particularly suited to this complexity because it does not require picking one memory to focus on — it works with the whole system, building trust with protectors first so that deeper work can happen safely and at a sustainable pace, rather than overwhelming you.',
    ]}
  />

  <SignsList
    heading="Is IFS the Right Fit for Complex Trauma?"
    intro="IFS tends to be especially well-suited if:"
    signs={[
      'Your trauma involved repeated or prolonged experiences rather than a single event',
      'You notice conflicting internal reactions — wanting connection and distrusting it at once',
      'Previous trauma treatment felt too fast, too narrative-focused, or overwhelming',
      'You experience shifts between different emotional states or ways of coping',
      'You want a gradual, safety-first approach given the complexity of what happened',
    ]}
    note="Complex trauma rarely has one clean story to process — IFS is built to work with that complexity rather than forcing it into a single narrative."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <FaqAccordion
    faqs={[
      {
        question: "What makes trauma 'complex' rather than standard PTSD?",
        answer: 'Complex trauma typically involves repeated or prolonged experiences, often within relationships you depended on, and tends to affect a broader range of functioning than single-incident trauma.',
      },
      {
        question: 'Will this take longer than other trauma treatment?',
        answer: 'Often yes — complex trauma generally requires a longer, more gradual course of treatment given the depth and range of what is involved.',
      },
      {
        question: 'What if different parts of me want different things?',
        answer: 'That is common with complex trauma — IFS is specifically designed to work with internal conflict between parts, rather than requiring one unified position.',
      },
      {
        question: 'Is this safe to do without risking being overwhelmed?',
        answer: 'Building trust and stability with protector parts before deeper work is a core, deliberate part of the IFS process, specifically to avoid overwhelming you.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'IFS', href: '/approach/ifs' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'IFS for Childhood Trauma', href: '/approach/ifs/for-childhood-trauma' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
