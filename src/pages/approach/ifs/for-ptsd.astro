---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="IFS for PTSD in Brooklyn, NY | Brooklyn Therapy Services"
  description="IFS for PTSD in Brooklyn and online across New York. Understand flashbacks, hypervigilance, and numbing as parts still trying to protect you."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="IFS for PTSD in Brooklyn, NY"
    intro="PTSD symptoms — flashbacks, hypervigilance, numbing — often look like malfunctions. IFS reframes them as parts still trying to protect you from a threat that's already passed."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How IFS Addresses PTSD Specifically"
    paragraphs={[
      'PTSD symptoms can be understood through IFS as protector parts stuck in survival mode — hypervigilance scanning for renewed danger, numbing to prevent overwhelming pain, flashbacks as an exile part still holding the original experience as though it is happening now.',
      'Rather than treating these symptoms as things to eliminate, IFS works by building a relationship with each part, helping protectors understand that the threat has passed, and helping the exile integrate the experience as something that happened, not something still happening.',
    ]}
  />

  <SignsList
    heading="Is IFS the Right Fit for Your PTSD?"
    intro="IFS tends to be a strong match if:"
    signs={[
      "Flashbacks or intrusive memories feel like they're happening again, not just being remembered",
      'Hypervigilance or numbing feels like it has a mind of its own',
      "You want an approach that doesn't require detailed retelling of the traumatic event",
      'Previous exposure-based treatment felt too activating or overwhelming',
      "You're drawn to a gentler, parts-based way of understanding your symptoms",
    ]}
    note="Your nervous system isn't broken — parts of it are still working hard to protect you from something that's already over. IFS helps them find that out."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is IFS a recognized treatment for PTSD?',
        answer: 'Yes — IFS has a growing evidence base for PTSD and trauma specifically, including growing recognition among trauma researchers and clinicians.',
      },
      {
        question: 'How is this different from EMDR or exposure therapy?',
        answer: 'Those approaches typically involve more direct engagement with the traumatic memory; IFS works primarily through your internal parts and their relationship to the experience, which some clients find more tolerable.',
      },
      {
        question: 'Will this help with flashbacks specifically?',
        answer: 'Yes — IFS can help by working with the exile part holding the memory and helping it recognize the experience is in the past, reducing how often it gets triggered into the present.',
      },
      {
        question: 'Do I need a formal PTSD diagnosis to start this work?',
        answer: 'No — you do not need a diagnosis to benefit from IFS-informed trauma work.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'IFS', href: '/approach/ifs' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'IFS for Complex Trauma', href: '/approach/ifs/for-complex-trauma' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
