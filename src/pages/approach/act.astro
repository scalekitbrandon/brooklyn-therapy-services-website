---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="ACT Therapist in Brooklyn, NY | Acceptance & Commitment Therapy | Brooklyn Therapy Services"
  description="Work with an ACT therapist in Brooklyn for Acceptance and Commitment Therapy — in person or through online ACT therapy across New York."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="ACT Therapist in Brooklyn, NY"
    intro="Work with an ACT therapist in Brooklyn who blends Acceptance and Commitment Therapy with practical, values-based tools — making room for difficult thoughts and feelings while still moving toward what matters."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is ACT (Acceptance and Commitment Therapy)?"
    paragraphs={[
      'Acceptance and Commitment Therapy (ACT) is an evidence-based approach that focuses on psychological flexibility — the ability to stay present with difficult thoughts and feelings without letting them dictate your choices.',
      "Rather than trying to eliminate anxiety, sadness, or intrusive thoughts, an Acceptance and Commitment therapist helps you change your relationship to them, so you can keep acting in line with what matters to you even when things feel hard.",
      'Sessions typically happen weekly, in 45–50 minute sessions — in person with an ACT therapist in our Brooklyn office, or through online ACT therapy for clients anywhere in New York.',
    ]}
  />

  <SignsList
    heading="What ACT Can Help With"
    intro="ACT is especially effective for:"
    signs={[
      'Anxiety and OCD, especially when avoidance has taken over',
      'Chronic stress and burnout',
      'Difficulty tolerating uncertainty or discomfort',
      "Feeling stuck between what you want and what you're actually doing",
      'Perfectionism and rigid thinking patterns',
      'Values clarification during a major life transition',
    ]}
    note="ACT isn't about positive thinking — it's about building the flexibility to act on your values even when your thoughts and feelings aren't cooperating."
  />

  <ProseSection
    heading="Our Approach to ACT"
    paragraphs={[
      'We use ACT alongside CBT and psychodynamic work, tailoring the balance to what you respond to. Sessions often include values clarification exercises and practical tools for defusing from unhelpful thoughts.',
      'The goal is not to feel good all the time — it is to build a life that feels meaningful, even alongside difficulty.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use ACT"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — tailored to your specific goals.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Integrates ACT alongside psychodynamic therapy and CBT for a warm, collaborative approach.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is ACT the same as CBT?',
        answer: 'They are related but distinct. CBT focuses on changing the content of your thoughts; ACT focuses on changing your relationship to them, without necessarily needing to change them at all.',
      },
      {
        question: 'Does ACT work for OCD specifically?',
        answer: 'Yes — ACT principles pair well with ERP for OCD, helping you tolerate the discomfort of resisting compulsions.',
      },
      {
        question: 'What does an ACT session actually look like?',
        answer: 'Expect a mix of conversation, values-based exercises, and practical strategies for handling difficult thoughts in the moment — it is collaborative, not just talk therapy.',
      },
      {
        question: 'How long does ACT-based therapy take?',
        answer: 'It varies by what you are working on — some clients see shifts within a few months, others continue longer as new goals emerge.',
      },
      {
        question: 'Do you offer online ACT therapy in New York?',
        answer: 'Yes — we offer online ACT therapy for clients located anywhere in New York, in addition to in-person sessions with an ACT therapist in Brooklyn.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'ACT for Anxiety', href: '/approach/act/for-anxiety' },
      { label: 'ACT for OCD', href: '/approach/act/for-ocd' },
      { label: 'ACT for Depression', href: '/approach/act/for-depression' },
      { label: 'ACT for Trauma', href: '/approach/act/for-trauma' },
      { label: 'ACT for Stress', href: '/approach/act/for-stress' },
      { label: 'ACT for Perfectionism', href: '/approach/act/for-perfectionism' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'ERP', href: '/approach/erp' },
      { label: 'IFS', href: '/approach/ifs' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
