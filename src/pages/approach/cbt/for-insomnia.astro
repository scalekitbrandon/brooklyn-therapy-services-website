---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="CBT for Insomnia in Brooklyn, NY | Brooklyn Therapy Services"
  description="CBT-I for insomnia in Brooklyn and online across New York. A short, structured protocol that targets the habits keeping sleep problems in place."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="CBT for Insomnia in Brooklyn, NY"
    intro="Chronic insomnia is often kept in place by the very habits used to cope with it. CBT-I directly targets those habits and the anxiety around sleep itself."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How CBT Targets Insomnia Specifically"
    paragraphs={[
      'Insomnia frequently becomes self-perpetuating: a bad night leads to anxiety about sleep, which leads to compensating behaviors (napping, sleeping in, extra time in bed) that actually weaken your sleep drive and worsen the problem the following night.',
      'CBT-I (Cognitive Behavioral Therapy for Insomnia) uses specific techniques including sleep restriction (temporarily limiting time in bed to rebuild sleep pressure), stimulus control (reserving the bed only for sleep), and cognitive work on anxious beliefs about sleep itself.',
    ]}
  />

  <SignsList
    heading="Is CBT-I the Right Fit for Your Insomnia?"
    intro="CBT-I tends to be a strong match if:"
    signs={[
      'You lie awake anxious about not sleeping, which makes sleep harder',
      'You have tried sleep hygiene tips without lasting improvement',
      'You spend excessive time in bed awake, hoping sleep will come',
      "Worry about tomorrow's functioning intensifies at bedtime",
      'You want a structured, short-term protocol rather than ongoing sleep medication',
    ]}
    note="CBT-I often works faster than people expect — most protocols run 4 to 8 sessions, not months of gradual change."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use CBT-I"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — tailored to your specific goals.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, collaborative care integrating CBT alongside ACT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: "What is 'sleep restriction'?",
        answer: 'A temporary technique that limits time in bed to match your actual sleep time, which rebuilds sleep pressure and often improves sleep quality within a couple of weeks, even though it feels counterintuitive at first.',
      },
      {
        question: 'Do I have to stop sleep medication to do this?',
        answer: 'Not necessarily — we can coordinate with your prescriber if you are on sleep medication and discuss a plan together.',
      },
      {
        question: 'How long does CBT-I usually take?',
        answer: 'It is one of the shorter, more structured protocols we offer — often 4 to 8 sessions.',
      },
      {
        question: 'Will this help if my insomnia is caused by anxiety generally, not just sleep-specific worry?',
        answer: 'Often yes — we can address both together, though CBT-I\'s specific techniques target the sleep-specific patterns directly.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
