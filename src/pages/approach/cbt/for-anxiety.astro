---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="CBT for Anxiety in Brooklyn, NY | Brooklyn Therapy Services"
  description="CBT for anxiety in Brooklyn and online across New York. Evidence-based cognitive behavioral techniques for worry, panic, and avoidance."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="CBT for Anxiety in Brooklyn, NY"
    intro="Cognitive Behavioral Therapy is one of the most well-researched treatments for anxiety — because anxiety is, at its core, a thinking-pattern problem as much as a feeling problem. Here's how CBT specifically targets it."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How CBT Targets Anxiety Specifically"
    paragraphs={[
      "Anxiety runs on a predictable loop: a triggering thought (\"what if something goes wrong\") leads to a physical alarm response, which then gets interpreted as proof the threat is real — reinforcing the original thought. CBT interrupts this loop at the thought level.",
      'Specific techniques used for anxiety include cognitive restructuring (identifying and testing anxious predictions against real evidence), behavioral experiments (testing feared outcomes in controlled, low-stakes ways), and structured worry time (containing rumination to a scheduled window instead of letting it run all day).',
    ]}
  />

  <SignsList
    heading="Is CBT the Right Fit for Your Anxiety?"
    intro="CBT tends to be an especially strong match if:"
    signs={[
      'Your anxious thoughts follow identifiable patterns (catastrophizing, mind-reading, fortune-telling)',
      'You want concrete tools you can use between sessions, not just a space to talk',
      'Your anxiety responds to logic and evidence once you slow down enough to examine it',
      "You're dealing with generalized worry, panic, or a specific phobia, rather than OCD-type compulsions",
      'You prefer a structured, goal-oriented approach over open-ended exploration',
    ]}
    note="If compulsions or rituals are part of your anxiety, ERP — not standard CBT — is usually the better-fitting treatment. See our OCD page to check."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use CBT for Anxiety"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with particular experience treating severe anxiety.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for anxiety, integrating CBT alongside ACT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'How is CBT for anxiety different from just talking about my worries?',
        answer: "CBT is structured and skills-based — you'll leave sessions with specific techniques to test between appointments, not just processed feelings.",
      },
      {
        question: 'How many sessions of CBT does anxiety usually take?',
        answer: 'Many clients see meaningful reduction in anxiety symptoms within 12–16 sessions of consistent CBT work, though this varies by severity.',
      },
      {
        question: 'Can CBT help with panic attacks specifically?',
        answer: 'Yes — CBT is one of the most effective treatments for panic, often combining cognitive restructuring with interoceptive exposure (safely reproducing physical panic sensations to reduce their power).',
        answerHtml: 'Yes — CBT is one of the most effective treatments for panic. See our page on <a href="/approach/cbt/for-panic-attacks">CBT for Panic Attacks</a> for how that works specifically.',
      },
      {
        question: "What if CBT alone isn't enough?",
        answer: 'We often blend CBT with ACT for anxiety that has a strong avoidance component, or explore psychodynamic roots if the anxiety connects to deeper patterns.',
      },
      {
        question: 'Do you offer CBT for anxiety online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'CBT for Panic Attacks', href: '/approach/cbt/for-panic-attacks' },
      { label: 'CBT for OCD', href: '/approach/cbt/for-ocd' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'ACT', href: '/approach/act' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
