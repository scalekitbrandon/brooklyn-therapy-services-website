---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="CBT for Social Anxiety in Brooklyn, NY | Brooklyn Therapy Services"
  description="CBT for social anxiety in Brooklyn and online across New York. Drop the safety behaviors that quietly keep the fear in place."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="CBT for Social Anxiety in Brooklyn, NY"
    intro="Social anxiety runs on a specific fear — being negatively judged — and a set of safety behaviors that quietly keep it in place. CBT targets both directly."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How CBT Targets Social Anxiety Specifically"
    paragraphs={[
      "Social anxiety is maintained by two things: a fear of negative judgment, and 'safety behaviors' used to prevent it — over-rehearsing what to say, avoiding eye contact, staying quiet to avoid saying something wrong. These behaviors feel protective but actually prevent you from learning that the feared outcome usually doesn't happen.",
      'CBT for social anxiety uses cognitive work to identify and test these fears, combined with gradual exposure to social situations while dropping the safety behaviors one at a time — so you get real evidence that disconfirms the fear.',
    ]}
  />

  <SignsList
    heading="Is CBT the Right Fit for Your Social Anxiety?"
    intro="CBT tends to be a strong match if:"
    signs={[
      'You replay social interactions afterward, scanning for mistakes',
      'You use specific behaviors to feel safer in social situations (over-preparing, avoiding certain topics, staying quiet)',
      "Fear of judgment has led you to avoid situations you'd otherwise want to be part of",
      'You want a structured way to build confidence in social settings, not just talk about it',
    ]}
    note="The safety behaviors that feel like they're protecting you in social situations are often exactly what keeps the anxiety going."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use CBT for Social Anxiety"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with particular experience treating severe anxiety.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for anxiety, integrating CBT alongside ACT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: "What are 'safety behaviors'?",
        answer: 'Small habits used to feel safer in feared situations — like avoiding eye contact or over-rehearsing what to say — that actually prevent you from learning the situation is more okay than it feels.',
      },
      {
        question: 'Will I have to do exposure exercises in social situations?',
        answer: 'Gradually and collaboratively, yes — this is one of the most effective parts of treatment, built at a pace that feels manageable.',
      },
      {
        question: 'How is this different from just being shy?',
        answer: 'Shyness is a personality trait; social anxiety involves significant distress and avoidance that gets in the way of things you want to do. Treatment is about the latter.',
      },
      {
        question: 'How long does this usually take?',
        answer: 'Many clients see meaningful improvement within a few months of consistent work, particularly once exposure exercises begin.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'CBT for Panic Attacks', href: '/approach/cbt/for-panic-attacks' },
      { label: 'ACT for Anxiety', href: '/approach/act/for-anxiety' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
