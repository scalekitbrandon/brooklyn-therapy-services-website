---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="CBT for Panic Attacks in Brooklyn, NY | Brooklyn Therapy Services"
  description="CBT for panic attacks in Brooklyn and online across New York, using interoceptive exposure and cognitive techniques."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="CBT for Panic Attacks in Brooklyn, NY"
    intro="Panic attacks feel like they come out of nowhere, but they follow a specific, treatable pattern — and CBT targets that pattern directly."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How CBT Treats Panic Attacks Specifically"
    paragraphs={[
      'Panic attacks are driven by catastrophic misinterpretation of normal body sensations — a racing heart gets interpreted as a heart attack, which triggers more adrenaline, which intensifies the sensation, confirming the fear. CBT for panic breaks this loop using a technique called interoceptive exposure: deliberately and safely inducing panic-like sensations (via exercise, breath-holding, spinning) in session to teach your brain that the sensations aren\'t dangerous.',
      "This is paired with cognitive work on the catastrophic misinterpretations themselves, and often a gradual return to any situations you've started avoiding because of panic.",
    ]}
  />

  <SignsList
    heading="Signs CBT for Panic Might Help"
    intro="This approach tends to be a strong fit if:"
    signs={[
      'Panic attacks seem to come out of nowhere, with intense physical symptoms (racing heart, dizziness, chest tightness)',
      "You've started avoiding places or situations where a panic attack has happened before",
      "You're afraid of the physical sensations themselves, not just external triggers",
      'You have had medical workups that ruled out a physical cause',
      'You want a structured, time-limited approach with measurable progress',
    ]}
    note="Panic attacks are one of the most treatable anxiety presentations — many people see significant reduction with a relatively short course of focused CBT."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Treat Panic Attacks"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with particular experience treating severe anxiety and panic.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for anxiety, integrating CBT alongside ACT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Will you deliberately try to trigger a panic attack in session?',
        answer: 'With your consent and always at a pace you set, yes — interoceptive exposure (safely reproducing panic sensations) is one of the most effective evidence-based techniques for treating panic.',
      },
      {
        question: 'How long does CBT for panic attacks usually take?',
        answer: 'Panic is one of the more responsive anxiety presentations to CBT — many clients see significant improvement within 8–12 sessions.',
      },
      {
        question: 'What if my panic attacks happen in specific places, like the subway?',
        answer: 'We will incorporate gradual exposure to those specific situations as part of treatment, alongside the core CBT and interoceptive work.',
      },
      {
        question: 'Is medication ever part of treatment for panic attacks?',
        answer: 'Some clients also work with a prescriber alongside therapy. We can discuss whether that is worth exploring for you.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'CBT for Anxiety', href: '/approach/cbt/for-anxiety' },
      { label: 'ACT', href: '/approach/act' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
