---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="CBT for Depression in Brooklyn, NY | Brooklyn Therapy Services"
  description="CBT for depression in Brooklyn and online across New York. Cognitive restructuring and behavioral activation to break the withdrawal cycle."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="CBT for Depression in Brooklyn, NY"
    intro="Depression often runs on a cycle of withdrawal and negative thinking that reinforces itself. CBT targets both sides of that cycle directly."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How CBT Targets Depression Specifically"
    paragraphs={[
      "Depression tends to involve two reinforcing patterns: negative, distorted thinking (\"I'm a failure,\" \"nothing will get better\") and behavioral withdrawal (avoiding activities that used to bring reward or connection). Each pattern feeds the other.",
      'CBT for depression combines cognitive restructuring (testing depressive thoughts against real evidence) with behavioral activation (deliberately scheduling activities that provide mastery or pleasure, even before motivation returns) — working on both sides of the cycle at once.',
    ]}
  />

  <SignsList
    heading="Is CBT the Right Fit for Your Depression?"
    intro="CBT tends to be a strong match if:"
    signs={[
      'Negative thoughts about yourself, the future, or the world feel persistent and specific',
      "You've noticed you're doing less of what you used to enjoy or find meaningful",
      'You want structured, measurable steps rather than open-ended talk',
      'Low motivation has become a barrier to functioning day-to-day',
      'You respond well to homework and between-session practice',
    ]}
    note="Depression convinces you that nothing will help before you've tried — CBT's structure is partly designed to test that belief directly."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use CBT for Depression"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — tailored to your specific goals.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for depression, integrating CBT alongside ACT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'What is behavioral activation?',
        answer: 'It is the practice of scheduling and doing activities that provide a sense of accomplishment or enjoyment, even when motivation is low — motivation often follows action in depression, not the other way around.',
      },
      {
        question: 'How long does CBT for depression typically take?',
        answer: 'Many clients see meaningful improvement within 12–20 sessions, though this varies by severity and history.',
      },
      {
        question: 'Will I have to do homework?',
        answer: 'Often, yes — thought records and scheduled activities are core parts of CBT, though we adjust based on what is realistic for you.',
      },
      {
        question: 'Can this be combined with medication?',
        answer: 'Yes — many clients use therapy and medication together, and we can discuss whether a referral makes sense.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'ACT for Depression', href: '/approach/act/for-depression' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
