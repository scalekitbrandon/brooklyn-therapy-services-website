---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="CBT for OCD in Brooklyn, NY | Brooklyn Therapy Services"
  description="How CBT fits alongside ERP for OCD treatment in Brooklyn and online across New York."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="CBT for OCD in Brooklyn, NY"
    intro="Standard CBT plays a specific, supporting role in OCD treatment — it isn't the primary treatment on its own. Here's exactly where it fits alongside ERP."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="Where CBT Fits Into OCD Treatment"
    paragraphs={[
      'For OCD specifically, <a href="/approach/erp">ERP (Exposure and Response Prevention)</a> is the primary, most effective treatment — not general CBT. Standard CBT\'s cognitive restructuring techniques (testing whether a feared thought is "true") can actually backfire with OCD, since debating with an obsession often feeds the compulsive cycle rather than breaking it.',
      'Where CBT does help: identifying the specific thought patterns and cognitive distortions that fuel your OCD (inflated responsibility, thought-action fusion, intolerance of uncertainty), which then informs a more targeted ERP plan.',
    ]}
  />

  <SignsList
    heading="How to Tell If You Need ERP Instead of Standard CBT"
    intro="If your experience includes the following, ERP-focused treatment is the better primary approach:"
    signs={[
      'You perform rituals, checking, or mental reviewing to reduce anxiety from a specific thought',
      'You seek reassurance repeatedly about the same fear',
      'Avoidance has narrowed your daily life around specific triggers',
      "Standard talk therapy has helped you understand your OCD but hasn't reduced the compulsions",
      "You've noticed that analyzing or debating the thought makes it worse, not better",
    ]}
    note="This is exactly why the combination matters: CBT helps map the thought patterns, ERP is what actually breaks the cycle."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Treat OCD"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Particular experience working with OCD and severe anxiety, using ERP alongside CBT and ACT.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: "Why isn't regular CBT enough for OCD?",
        answer: 'Debating or reasoning with obsessive thoughts (a core CBT technique) can inadvertently function as a mental compulsion, reinforcing OCD rather than resolving it. ERP addresses this directly by working with avoidance and rituals instead.',
      },
      {
        question: 'So should I do CBT or ERP for my OCD?',
        answer: 'For OCD specifically, ERP should be the primary treatment. We may use CBT-informed thought-pattern mapping alongside it, but ERP does the actual symptom-reducing work.',
        answerHtml: 'For OCD specifically, <a href="/approach/erp">ERP</a> should be the primary treatment. We may use CBT-informed thought-pattern mapping alongside it, but ERP does the actual symptom-reducing work.',
      },
      {
        question: 'Will my therapist explain which technique they are using and when?',
        answer: 'Yes — we will walk through the treatment plan together so you understand what each part of the work is doing.',
      },
      {
        question: 'How long does this combined approach typically take?',
        answer: 'Many clients see meaningful OCD symptom reduction within a few months of consistent ERP-primary treatment.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'ERP', href: '/approach/erp' },
      { label: 'ACT for OCD', href: '/approach/act/for-ocd' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
