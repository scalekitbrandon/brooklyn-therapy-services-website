---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="ERP Therapist in Brooklyn, NY | Exposure & Response Prevention | Brooklyn Therapy Services"
  description="Work with an ERP therapist in Brooklyn for Exposure and Response Prevention — in person or through online ERP therapy across New York."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="ERP Therapist in Brooklyn, NY"
    intro="Work with an ERP therapist in Brooklyn for Exposure and Response Prevention — a structured, evidence-based approach for reducing OCD compulsions and anxiety-driven avoidance."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is ERP (Exposure and Response Prevention)?"
    paragraphs={[
      'Exposure and Response Prevention (ERP) is considered the gold-standard treatment for OCD. Working with an Exposure Response Prevention therapist, you gradually and safely face feared thoughts or situations (exposure), while resisting the urge to perform compulsions or rituals (response prevention).',
      'Over time, this retrains your nervous system to tolerate the anxiety without needing to neutralize it — breaking the cycle that keeps OCD in place.',
      "Sessions are collaborative and paced carefully — in person with an ERP therapist in our Brooklyn office, or through online ERP therapy for clients anywhere in New York. We build a plan together before any exposure work begins, and you're always in control of the pace.",
    ]}
  />

  <SignsList
    heading="What ERP Can Help With"
    intro="ERP is especially effective for:"
    signs={[
      'Obsessive-compulsive disorder (OCD), in its many forms',
      'Checking, reassurance-seeking, or mental rituals',
      'Contamination fears and washing or cleaning compulsions',
      'Intrusive thoughts that feel impossible to ignore',
      'Specific phobias and anxiety-driven avoidance',
      'Health anxiety and related compulsive behaviors',
    ]}
    note="ERP can sound intimidating, but it's always done gradually and collaboratively — you're never pushed into something before you're ready."
  />

  <ProseSection
    heading="Our Approach to ERP"
    paragraphs={[
      'We combine ERP with ACT principles, helping you build the willingness to sit with discomfort without avoiding it — which is ultimately what breaks the OCD cycle.',
      'Every exposure plan is built together, starting with what feels manageable and building from there at a pace that is realistic for you.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use ERP"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Particular experience working with OCD and severe anxiety, using ERP alongside ACT and CBT.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is ERP only for OCD?',
        answer: 'It is most associated with OCD, but the same principles can help with specific phobias and other anxiety-driven avoidance patterns.',
      },
      {
        question: 'Will I be forced into uncomfortable situations right away?',
        answer: 'No. We build a gradual hierarchy together, starting with lower-anxiety exposures and working up — always at a pace you help set.',
      },
      {
        question: 'How is ERP different from regular anxiety therapy?',
        answer: 'ERP is a specific, structured protocol targeting compulsions and avoidance directly, rather than general anxiety management — it tends to be more directive.',
      },
      {
        question: 'How long does ERP typically take?',
        answer: 'Many clients see meaningful reduction in OCD symptoms within a few months of consistent ERP work, though this depends on severity and specific symptoms.',
      },
      {
        question: 'Do you offer online ERP therapy in New York?',
        answer: 'Yes — we offer online ERP therapy for clients located anywhere in New York, in addition to in-person sessions with an ERP therapist in Brooklyn.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'ACT', href: '/approach/act' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'IFS', href: '/approach/ifs' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
