---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SpecialtyHero from '../../components/SpecialtyHero.astro';
import ProseSection from '../../components/ProseSection.astro';
import SignsList from '../../components/SignsList.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import SpecialistMatch from '../../components/SpecialistMatch.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../components/RelatedSpecialties.astro';
import ContactCta from '../../components/ContactCta.astro';
import Footer from '../../components/Footer.astro';
import rachelPhoto from '../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="CBT Therapist in Brooklyn, NY | Cognitive Behavioral Therapy | Brooklyn Therapy Services"
  description="Work with a CBT therapist in Brooklyn for Cognitive Behavioral Therapy — in person or through online CBT therapy across New York."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="CBT Therapist in Brooklyn, NY"
    intro="Work with a CBT therapist in Brooklyn for structured, practical Cognitive Behavioral Therapy — identifying and shifting the thought patterns that keep anxiety, depression, and stress in place."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="What Is CBT (Cognitive Behavioral Therapy)?"
    paragraphs={[
      'Cognitive Behavioral Therapy (CBT) is one of the most researched forms of talk therapy, based on the idea that our thoughts, feelings, and behaviors are all connected — and that shifting one can shift the others.',
      'In practice, this means working with a Cognitive Behavioral therapist to identify unhelpful thought patterns (like catastrophizing or all-or-nothing thinking) and build more balanced, realistic ways of responding to difficult situations.',
      'Sessions typically happen weekly, in 45–50 minute sessions — in person with a CBT therapist in our Brooklyn office, or through online CBT therapy for clients anywhere in New York.',
    ]}
  />

  <SignsList
    heading="What CBT Can Help With"
    intro="CBT is especially effective for:"
    signs={[
      'Anxiety, panic, and generalized worry',
      'Depression and low motivation',
      'Negative or distorted thinking patterns',
      'Sleep difficulties tied to racing thoughts',
      'Specific phobias',
      'Building concrete coping skills for daily stress',
    ]}
    note="CBT is often short-to-medium term and skills-focused — many clients leave sessions with something concrete to practice, not just insight."
  />

  <ProseSection
    heading="Our Approach to CBT"
    paragraphs={[
      'We use CBT alongside ACT and psychodynamic work, so you get both practical tools and a deeper understanding of where the thought patterns came from.',
      'Expect some structure — tracking thoughts, testing assumptions, building coping strategies — balanced with the same warmth and collaboration as the rest of our work.',
    ]}
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use CBT"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — tailored to your specific goals.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Integrates CBT alongside psychodynamic therapy and ACT for a warm, collaborative approach.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: "Is CBT just about 'positive thinking'?",
        answer: 'No — CBT is about accuracy, not positivity. The goal is more balanced, realistic thoughts, not forced optimism.',
      },
      {
        question: 'Will I get homework?',
        answer: 'Sometimes. CBT often includes between-session practice — thought records, behavioral experiments — though we adjust based on what is useful for you.',
      },
      {
        question: 'How is this different from just venting to a therapist?',
        answer: 'CBT is more structured and goal-oriented, with specific techniques for identifying and shifting patterns, rather than open-ended processing alone.',
      },
      {
        question: 'How long does CBT typically take?',
        answer: 'Many clients see meaningful change within 3–6 months of consistent work, though this varies by what you are addressing.',
      },
      {
        question: 'Do you offer online CBT therapy in New York?',
        answer: 'Yes — we offer online CBT therapy for clients located anywhere in New York, in addition to in-person sessions with a CBT therapist in Brooklyn.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'CBT for Anxiety', href: '/approach/cbt/for-anxiety' },
      { label: 'CBT for OCD', href: '/approach/cbt/for-ocd' },
      { label: 'CBT for Panic Attacks', href: '/approach/cbt/for-panic-attacks' },
      { label: 'CBT for Depression', href: '/approach/cbt/for-depression' },
      { label: 'CBT for Social Anxiety', href: '/approach/cbt/for-social-anxiety' },
      { label: 'CBT for Insomnia', href: '/approach/cbt/for-insomnia' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'ACT', href: '/approach/act' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'ERP', href: '/approach/erp' },
      { label: 'IFS', href: '/approach/ifs' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
