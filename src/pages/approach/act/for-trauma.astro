---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="ACT for Trauma in Brooklyn, NY | Brooklyn Therapy Services"
  description="ACT for trauma in Brooklyn and online across New York. Reduce avoidance's grip so your life can get bigger again, alongside deeper trauma processing."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="ACT for Trauma in Brooklyn, NY"
    intro="Trauma often leaves you avoiding reminders, places, or feelings connected to what happened. ACT helps you widen your life back out, even while some of that discomfort is still present."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How ACT Supports Trauma Recovery"
    paragraphs={[
      'One of trauma\'s most limiting effects is avoidance — of places, people, feelings, even your own memories. ACT does not ask you to stop having those feelings; it works on reducing how much avoidance controls your day-to-day choices, so your life can get bigger again even while healing is still in progress.',
      'This often works alongside <a href="/approach/psychodynamic">psychodynamic</a> processing of the underlying experience — ACT provides the willingness and values-based tools that make it possible to re-engage with life during that deeper work, rather than waiting until it is "done."',
    ]}
  />

  <SignsList
    heading="Is ACT the Right Fit Alongside Your Trauma Work?"
    intro="ACT tends to help most when paired with deeper trauma processing if:"
    signs={[
      'Avoidance has shrunk your world — places, relationships, or activities you no longer engage with',
      "You feel stuck waiting to 'heal enough' before living fully again",
      'Hypervigilance or emotional numbness gets in the way of pursuing what matters to you',
      'You want practical tools for daily functioning while deeper processing work continues',
    ]}
    note="ACT isn't typically a stand-alone trauma treatment — it's most powerful paired with deeper processing work, giving you a way to keep living while that work happens."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use ACT for Trauma"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Particular experience working with complex trauma, using an integrative blend of psychodynamic work, ACT, and CBT.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is ACT enough to treat trauma on its own?',
        answer: 'Usually not as a stand-alone approach — we typically pair it with psychodynamic or other trauma-processing work, using ACT for the daily-functioning and avoidance piece.',
        answerHtml: 'Usually not as a stand-alone approach — we typically pair it with <a href="/approach/psychodynamic">psychodynamic</a> or other trauma-processing work, using ACT for the daily-functioning and avoidance piece.',
      },
      {
        question: 'Will ACT ask me to face trauma reminders directly?',
        answer: 'Not in a forced or exposure-heavy way — ACT focuses more on reducing avoidance\'s grip on your choices than on direct exposure exercises.',
      },
      {
        question: 'How does this help with hypervigilance?',
        answer: "ACT's defusion skills can help create space between a hypervigilant reaction and your response to it, though this often works best alongside nervous-system-focused work too.",
      },
      {
        question: 'Is this a good fit for complex trauma?',
        answer: 'It can be one part of a broader plan — often combined with psychodynamic work for complex, longstanding trauma patterns.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'ACT', href: '/approach/act' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
      { label: 'IFS for Trauma', href: '/approach/ifs/for-trauma' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
