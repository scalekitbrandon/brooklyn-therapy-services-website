---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="ACT for OCD in Brooklyn, NY | Brooklyn Therapy Services"
  description="ACT-informed OCD treatment in Brooklyn and online across New York, building the psychological flexibility that supports ERP."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="ACT for OCD in Brooklyn, NY"
    intro="ACT doesn't try to eliminate obsessive thoughts — it changes your relationship to them, which is exactly the skill that makes ERP's exposure work sustainable long-term."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How ACT Supports OCD Treatment"
    paragraphs={[
      "OCD thrives on certainty-seeking: the compulsive urge to make an uncomfortable thought \"go away\" or be proven false. ACT's core skill — psychological flexibility, the ability to hold a difficult thought without needing to act on it — is directly what's required to resist a compulsion during ERP.",
      "In practice, this means ACT provides the \"why\" and the willingness-building work (values clarification, defusion techniques for stepping back from a thought) that make the harder moments of <a href=\"/approach/erp\">ERP</a>'s exposure exercises tolerable.",
    ]}
  />

  <SignsList
    heading="Signs ACT-Informed OCD Treatment Might Help"
    intro="ACT pairs especially well with ERP if:"
    signs={[
      "You understand intellectually that compulsions don't work, but still struggle to resist the urge in the moment",
      'You get stuck trying to achieve 100% certainty before you can let a thought go',
      'Values feel disconnected from your day-to-day choices because OCD is dictating them instead',
      'You want tools for the moments between sessions when an obsession hits hard',
    ]}
    note="ACT is rarely used alone for OCD — it's most effective as the willingness-building companion to ERP, not a replacement for it."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Treat OCD"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Particular experience working with OCD and severe anxiety, using ERP alongside ACT and CBT.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Is ACT a replacement for ERP in treating OCD?',
        answer: 'No — ERP remains the primary, most effective treatment for OCD. ACT is typically used alongside it to build the psychological flexibility that makes exposure work more sustainable.',
        answerHtml: 'No — <a href="/approach/erp">ERP</a> remains the primary, most effective treatment for OCD. ACT is typically used alongside it to build the psychological flexibility that makes exposure work more sustainable.',
      },
      {
        question: 'What does "defusion" mean in ACT?',
        answer: 'Defusion is the practice of stepping back from a thought and observing it, rather than treating it as a fact you must respond to — a core skill for resisting OCD compulsions.',
      },
      {
        question: 'How does ACT help me tolerate uncertainty?',
        answer: 'Rather than trying to resolve uncertainty (which feeds OCD), ACT helps you build willingness to act in line with your values even while uncertainty is present.',
      },
      {
        question: 'Will I still need ERP if I do ACT?',
        answer: 'For OCD specifically, yes — ERP does the direct exposure-based work; ACT supports it.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'ERP', href: '/approach/erp' },
      { label: 'CBT for OCD', href: '/approach/cbt/for-ocd' },
      { label: 'ACT', href: '/approach/act' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
