---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="ACT for Perfectionism in Brooklyn, NY | Brooklyn Therapy Services"
  description="ACT for perfectionism in Brooklyn and online across New York. Work on the fear underneath the standards, not just the standards themselves."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="ACT for Perfectionism in Brooklyn, NY"
    intro="Perfectionism usually isn't about high standards — it's about the fear underneath them. ACT works on your relationship to that fear, not just the standards themselves."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How ACT Targets Perfectionism"
    paragraphs={[
      "Perfectionism is often driven by a rigid rule: \"if it's not perfect, it's a failure — and failure means something bad about me.\" This rule creates procrastination (avoiding starting until conditions are perfect), overworking, and harsh self-criticism when standards inevitably aren't met.",
      "ACT works by loosening the grip of this rule through defusion (noticing \"not perfect equals failure\" as a thought, not a fact) and values work (connecting to what actually matters about the task, rather than the fear of falling short).",
    ]}
  />

  <SignsList
    heading="Is ACT the Right Fit for Your Perfectionism?"
    intro="ACT tends to help most if:"
    signs={[
      "You procrastinate or avoid starting things until conditions feel 'right'",
      'Harsh self-criticism follows anything less than a flawless outcome',
      'You over-prepare or over-check well past the point of diminishing returns',
      "Perfectionism has started limiting what you're willing to try or share",
      'You want a different relationship to mistakes, not just fewer of them',
    ]}
    note="The goal isn't to lower your standards — it's to stop letting the fear underneath them make all your decisions."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use ACT for Perfectionism"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — tailored to your specific goals.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, collaborative care integrating ACT alongside CBT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Will therapy make me care less about doing good work?',
        answer: 'No — the goal is to separate genuine care about quality from fear-driven perfectionism, so your standards come from values, not anxiety.',
      },
      {
        question: 'Is perfectionism the same as OCD?',
        answer: "They can overlap, but perfectionism isn't a diagnosis and doesn't necessarily involve OCD's specific obsession-compulsion cycle. If checking or reassurance rituals are involved, our OCD page may be more relevant.",
        answerHtml: 'They can overlap, but perfectionism is not a diagnosis and does not necessarily involve OCD\'s specific obsession-compulsion cycle. If checking or reassurance rituals are involved, our <a href="/specialties/ocd">OCD page</a> may be more relevant.',
      },
      {
        question: 'How does this help with procrastination?',
        answer: "By loosening the 'must be perfect or don't start' rule, ACT makes it easier to begin imperfectly rather than waiting for ideal conditions that never arrive.",
      },
      {
        question: 'Can this help with perfectionism at work specifically?',
        answer: 'Yes — many clients apply this work directly to workplace patterns like overworking, difficulty delegating, or harsh self-evaluation.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'ACT', href: '/approach/act' },
      { label: 'CBT', href: '/approach/cbt' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
