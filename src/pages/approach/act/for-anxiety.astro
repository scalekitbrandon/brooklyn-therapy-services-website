---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="ACT for Anxiety in Brooklyn, NY | Brooklyn Therapy Services"
  description="ACT for anxiety in Brooklyn and online across New York. Reduce anxiety's grip on your choices, not just the feeling itself."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="ACT for Anxiety in Brooklyn, NY"
    intro="ACT takes a different stance than most anxiety treatments — instead of trying to reduce your anxiety directly, it changes how much power your anxious thoughts have over your choices."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How ACT Targets Anxiety Specifically"
    paragraphs={[
      'Most anxiety treatments aim to reduce anxious feelings directly. ACT does something different: it treats the struggle against anxiety — the avoidance, the reassurance-seeking, the mental effort spent trying to feel less anxious — as much of the actual problem, more than the anxiety itself.',
      "Core ACT techniques for anxiety include cognitive defusion (learning to notice an anxious thought without treating it as a command), values clarification (identifying what you'd do if anxiety weren't dictating your choices), and committed action (practicing that values-aligned behavior even while anxiety is present, not after it goes away).",
    ]}
  />

  <SignsList
    heading="Is ACT the Right Fit for Your Anxiety?"
    intro="ACT tends to be a strong match if:"
    signs={[
      "You've tried to 'think your way out of' anxiety before without lasting relief",
      'Avoidance has started shrinking your life — skipping things, over-preparing, over-checking',
      "You want to keep living fully rather than waiting for anxiety to disappear first",
      "Traditional CBT's focus on disputing thoughts hasn't clicked for you",
      "You're drawn to a more values-driven, less 'debate the thought' approach",
    ]}
    note="ACT won't necessarily make anxious thoughts go away faster — it changes how much they get to run your life in the meantime."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use ACT for Anxiety"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — with particular experience treating severe anxiety.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for anxiety, integrating ACT alongside CBT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: 'Does ACT try to make my anxiety go away?',
        answer: "Not directly — ACT focuses on reducing anxiety's control over your choices, which often reduces the anxiety itself as a byproduct, but that isn't the primary goal.",
      },
      {
        question: "How is this different from just 'accepting' my anxiety and doing nothing about it?",
        answer: "Acceptance in ACT is active, not passive — you're accepting the presence of anxious feelings while still taking meaningful action, not resigning yourself to suffering.",
      },
      {
        question: "What is 'cognitive defusion'?",
        answer: "It's the practice of noticing a thought as just a thought — not a fact you have to obey — which reduces its grip without needing to argue it away.",
      },
      {
        question: 'Can ACT be combined with CBT for anxiety?',
        answer: "Yes — many clients benefit from both: CBT's structured tools alongside ACT's values-based framework.",
        answerHtml: 'Yes — many clients benefit from both: <a href="/approach/cbt/for-anxiety">CBT\'s structured tools</a> alongside ACT\'s values-based framework.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'ACT', href: '/approach/act' },
      { label: 'CBT for Anxiety', href: '/approach/cbt/for-anxiety' },
      { label: 'ACT for OCD', href: '/approach/act/for-ocd' },
      { label: 'IFS for Anxiety', href: '/approach/ifs/for-anxiety' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
