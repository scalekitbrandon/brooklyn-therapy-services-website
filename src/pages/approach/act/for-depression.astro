---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SpecialtyHero from '../../../components/SpecialtyHero.astro';
import ProseSection from '../../../components/ProseSection.astro';
import SignsList from '../../../components/SignsList.astro';
import HowItWorks from '../../../components/HowItWorks.astro';
import SpecialistMatch from '../../../components/SpecialistMatch.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedSpecialties from '../../../components/RelatedSpecialties.astro';
import ContactCta from '../../../components/ContactCta.astro';
import Footer from '../../../components/Footer.astro';
import rachelPhoto from '../../../assets/images/rachel-headshot.jpg';
import lilyPhoto from '../../../assets/images/lily-headshot.jpg';

const footerGroups = [
  {
    heading: 'Explore',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Team', href: '/team' },
      { label: 'Specialties', href: '/specialties' },
      { label: 'Our Approach', href: '/approach' },
      { label: 'Online Therapy', href: '/online-therapy' },
      { label: 'Contact', href: '/#consultation-form' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'What We Help With',
    links: [
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'Couples Therapy', href: '/specialties/couples-therapy' },
      { label: 'Anxiety', href: '/specialties/anxiety' },
      { label: 'OCD', href: '/specialties/ocd' },
      { label: 'Trauma & PTSD', href: '/specialties/trauma-ptsd' },
      { label: 'Relationships & Attachment', href: '/specialties/relationships-attachment' },
      { label: 'Life Transitions', href: '/specialties/life-transitions' },
      { label: 'Sex & Intimacy', href: '/specialties/sex-intimacy' },
      { label: 'Grief & Loss', href: '/specialties/grief-loss' },
      { label: 'Stress & Burnout', href: '/specialties/stress-burnout' },
    ],
  },
];
---

<BaseLayout
  title="ACT for Depression in Brooklyn, NY | Brooklyn Therapy Services"
  description="ACT for depression in Brooklyn and online across New York. Rebuild values-aligned action first, even before mood improves."
>
  <Header slot="header" />

  <SpecialtyHero
    heading="ACT for Depression in Brooklyn, NY"
    intro="Depression often shrinks life down to avoidance and withdrawal. ACT works by rebuilding values-aligned action first — even before mood improves."
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <ProseSection
    heading="How ACT Targets Depression Specifically"
    paragraphs={[
      'Depression creates a trap: low mood leads to withdrawal from meaningful activity, which removes sources of reward and connection, which deepens the low mood further. Waiting to feel motivated before acting rarely breaks this cycle, because motivation typically follows action, not the other way around.',
      "ACT for depression focuses on identifying what actually matters to you, then taking small, values-aligned action toward it regardless of mood — paired with defusion skills for the self-critical thoughts (\"what's the point,\" \"I'm too far behind\") that keep the withdrawal going.",
    ]}
  />

  <SignsList
    heading="Is ACT the Right Fit for Your Depression?"
    intro="ACT tends to be a good match if:"
    signs={[
      "You've noticed withdrawing from people or activities makes things feel worse, not better",
      "Waiting to 'feel like it' before doing anything has stopped working",
      "Self-critical thoughts loop persistently ('what's the point,' 'I'm failing at this')",
      "You want to reconnect with what used to matter to you, not just reduce symptoms",
      'You are open to taking action before motivation shows up, not after',
    ]}
    note="ACT doesn't ask you to wait until you feel better to start living again — it works in the opposite direction."
  />

  <HowItWorks
    heading="Getting Started Is Simple"
    steps={[
      {
        number: '01',
        title: 'Reach Out',
        description: 'Send a message or book a free 15-minute consultation so we can understand what you need and answer any questions.',
      },
      {
        number: '02',
        title: 'Get Matched',
        description: "We'll pair you with a therapist whose approach and specialty fit your goals — no guesswork, no starting over.",
      },
      {
        number: '03',
        title: 'Begin Your Work',
        description: 'Start weekly sessions, in-person or online, in a space built for honest conversation and real progress.',
      },
    ]}
    ctaLabel="Book a Free Consultation"
    ctaHref="#consultation-form"
  />

  <SpecialistMatch
    heading="Therapists Who Use ACT for Depression"
    specialists={[
      {
        name: 'Rachel Vetter',
        credentials: 'LCSW',
        photo: rachelPhoto,
        blurb: 'Integrative approach blending psychodynamic work, ACT, and CBT — tailored to your specific goals.',
        href: '/team',
      },
      {
        name: 'Lily Berman',
        credentials: 'LMSW',
        photo: lilyPhoto,
        blurb: 'Warm, trauma-informed care for depression, integrating ACT alongside CBT and psychodynamic work.',
        href: '/team',
      },
    ]}
  />

  <FaqAccordion
    faqs={[
      {
        question: "Isn't it unrealistic to act before I feel motivated?",
        answer: 'It feels that way at first, but research consistently shows motivation tends to follow action in depression, not precede it — small steps build momentum.',
      },
      {
        question: "Will ACT tell me to just 'push through' when I'm struggling?",
        answer: 'No — this is not about forcing yourself through anything. It is about identifying genuinely small, values-aligned steps that are realistically possible, even on hard days.',
      },
      {
        question: 'How is this different from behavioral activation?',
        answer: 'They overlap significantly — ACT incorporates behavioral activation principles alongside values work and defusion from self-critical thoughts.',
      },
      {
        question: 'Can this be combined with medication for depression?',
        answer: 'Yes — many clients use therapy and medication together. We can discuss whether a referral to a prescriber makes sense for you.',
      },
      {
        question: 'Is this available online?',
        answer: 'Yes — available anywhere in New York via secure video.',
      },
    ]}
  />

  <RelatedSpecialties
    heading="Related Conditions & Approaches"
    items={[
      { label: 'Individual Therapy', href: '/specialties/individual-therapy' },
      { label: 'ACT', href: '/approach/act' },
      { label: 'CBT for Depression', href: '/approach/cbt/for-depression' },
      { label: 'Psychodynamic Therapy', href: '/approach/psychodynamic' },
    ]}
  />

  <ContactCta
    details={[
      { label: 'Email', value: 'info@brooklyntherapyservices.com' },
    ]}
  />

  <Footer
    slot="footer"
    logoText="Brooklyn Therapy Services"
    email="info@brooklyntherapyservices.com"
    groups={footerGroups}
  />
</BaseLayout>
